    function loadSavedState() {
      try {
        const raw = localStorage.getItem('vertex_master_v2_state');
        if (raw) {
          const parsed = JSON.parse(raw);
          if (typeof parsed.balance === 'number') state.balance = parsed.balance;
          if (Array.isArray(parsed.openPositions)) state.openPositions = parsed.openPositions;
          if (Array.isArray(parsed.tradeHistory)) state.tradeHistory = parsed.tradeHistory;
          if (parsed.guardrails) state.guardrails = { ...state.guardrails, ...parsed.guardrails };
          if (parsed.proModules) state.proModules = { ...state.proModules, ...parsed.proModules };
          if (Array.isArray(parsed.priceAlerts)) state.priceAlerts = parsed.priceAlerts;
          if (Array.isArray(parsed.externalWallets)) state.externalWallets = parsed.externalWallets;
        }
      } catch (e) {}
    }

    function saveState() {
      try {
        localStorage.setItem('vertex_master_v2_state', JSON.stringify({
          balance: state.balance,
          openPositions: state.openPositions,
          tradeHistory: state.tradeHistory,
          guardrails: state.guardrails,
          proModules: state.proModules,
          priceAlerts: state.priceAlerts,
          externalWallets: state.externalWallets
        }));
      } catch (e) {}
    }

    // =========================================================================
    // 5. HELPERS & TOAST NOTIFICATIONS
    // =========================================================================
    function formatNum(num, decimals = 2) {
      if (num === undefined || num === null || isNaN(num)) return '0,00';
      return Number(num).toLocaleString('fr-FR', {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals
      });
    }

    function getCurrentAsset() {
      return ASSETS.find(a => a.symbol === state.activeSymbol) || ASSETS[0];
    }

    function showToast(msg, icon = '⚡') {
      const banner = document.getElementById('toastBanner');
      document.getElementById('toastIcon').textContent = icon;
      document.getElementById('toastMessage').textContent = msg;
      banner.classList.remove('hidden');
      clearTimeout(window._toastTimer);
      window._toastTimer = setTimeout(hideToast, 3200);
    }

    function hideToast() {
      document.getElementById('toastBanner').classList.add('hidden');
    }

    // =========================================================================
    // 6. TAB NAVIGATION & BINANCE-STYLE VIEW SELECTOR
    // =========================================================================
    function switchTab(tabId) {
      state.activeTab = tabId;
      const tabs = ['terminal', 'signals', 'portfolio', 'news', 'install'];
      tabs.forEach(t => {
        const sec = document.getElementById('tab-' + t);
        const nav = document.getElementById('nav-' + t);
        if (t === tabId) {
          sec.classList.remove('hidden');
          nav.classList.add('text-[#00e676]', 'font-bold');
          nav.classList.remove('text-slate-400', 'font-medium');
        } else {
          sec.classList.add('hidden');
          nav.classList.remove('text-[#00e676]', 'font-bold');
          nav.classList.add('text-slate-400', 'font-medium');
        }
      });

      if (tabId === 'terminal') {
        requestAnimationFrame(drawChart);
      } else if (tabId === 'signals') {
        renderSignalsTab();
      } else if (tabId === 'portfolio') {
        renderPortfolioTab();
      } else if (tabId === 'news') {
        renderNewsTab();
        renderCalendarTab();
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function setTerminalLayout(mode) {
      const wrapper = document.getElementById('chartCanvasWrapper');
      const btnStd = document.getElementById('layoutBtn-standard');
      const btnChart = document.getElementById('layoutBtn-chart');

      if (mode === 'chart') {
        wrapper.className = 'relative w-full h-96 sm:h-[420px] rounded-xl bg-[#060c0b] border border-emerald-500/40 overflow-hidden transition-all';
        btnChart.className = 'px-2 py-0.5 rounded-md bg-emerald-950 text-[#00e676] border border-emerald-500/40 font-bold transition';
        btnStd.className = 'px-2 py-0.5 rounded-md bg-[#060c0b] text-slate-400 border border-vx-border hover:text-white transition';
      } else {
        wrapper.className = 'relative w-full h-64 sm:h-72 rounded-xl bg-[#060c0b] border border-vx-border overflow-hidden transition-all';
        btnStd.className = 'px-2 py-0.5 rounded-md bg-emerald-950 text-[#00e676] border border-emerald-500/40 font-bold transition';
        btnChart.className = 'px-2 py-0.5 rounded-md bg-[#060c0b] text-slate-400 border border-vx-border hover:text-white transition';
      }
      setTimeout(drawChart, 50);
    }

    function quickAlertCurrentAsset() {
      const asset = getCurrentAsset();
      const target = Number((asset.price * 1.008).toFixed(asset.decimals));
      state.priceAlerts.push({
        id: Date.now(),
        symbol: asset.symbol,
        price: target,
        triggered: false
      });
      saveState();
      renderPriceAlerts();
      showToast(`🔔 Alerte rapide créée sur ${asset.symbol} à ${formatNum(target, asset.decimals)}`, '🔔');
    }

    function jumpToWatchlist() {
      switchTab('terminal');
      setTimeout(() => {
        document.getElementById('watchlistSection').scrollIntoView({ behavior: 'smooth' });
      }, 80);
    }

    function openPwaModal() {
      document.getElementById('pwaModal').classList.remove('hidden');
    }

    function closePwaModal() {
      document.getElementById('pwaModal').classList.add('hidden');
    }

    // =========================================================================
    // 7. RETRACTABLE PRO TOOLS (OPT-IN & ZERO CPU WHEN UNCHECKED)
    // =========================================================================
    function toggleProSubmenu() {
      document.getElementById('proSubmenuDrawer').classList.toggle('hidden');
    }

    function syncProCheckboxesUI() {
      document.getElementById('chkOrderbook').checked = !!state.proModules.orderbook;
      document.getElementById('chkTrades').checked = !!state.proModules.trades;
      document.getElementById('chkRiskCalc').checked = !!state.proModules.riskcalc;
      document.getElementById('chkAlerts').checked = !!state.proModules.alerts;

      const activeCount = Object.values(state.proModules).filter(Boolean).length;
      document.getElementById('proActiveCount').textContent = activeCount;

      const container = document.getElementById('proModulesContainer');
      if (activeCount > 0) {
        container.classList.remove('hidden');
      } else {
        container.classList.add('hidden');
      }

      ['orderbook', 'trades', 'riskcalc', 'alerts'].forEach(mod => {
        const panel = document.getElementById('panel-' + mod);
        if (state.proModules[mod]) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });

      if (state.proModules.orderbook) renderOrderbookModule();
      if (state.proModules.trades) renderPublicTradesModule();
      if (state.proModules.riskcalc) updateProRiskCalculator();
      if (state.proModules.alerts) renderPriceAlerts();
    }

    function toggleProModule(modKey, enabled) {
      state.proModules[modKey] = enabled;
      saveState();
      syncProCheckboxesUI();
      showToast(enabled ? `Outil Pro activé` : `Outil Pro masqué (CPU libéré)`, '⚙️');
    }

    function renderOrderbookModule() {
      if (!state.proModules.orderbook || state.activeTab !== 'terminal') return;
      const panel = document.getElementById('panel-orderbook');
      if (!panel.open) return;

      const asset = getCurrentAsset();
      const p = asset.price;
      const step = p * 0.00032;
      const dec = asset.decimals;

      const baseBuy = asset.signal === 'ACHAT' ? 64 : 38;
      const buyPct = Math.min(84, Math.max(16, Math.round(baseBuy + (Math.random() * 6 - 3))));
      const sellPct = 100 - buyPct;

      document.getElementById('obBuyPressureTxt').textContent = `${buyPct}% Acheteurs`;
      document.getElementById('obSellPressureTxt').textContent = `${sellPct}% Vendeurs`;
      document.getElementById('obSpreadTxt').textContent = `Spread : ${formatNum(step * 0.4, dec)}`;
      document.getElementById('obBuyBar').style.width = buyPct + '%';
      document.getElementById('obSellBar').style.width = sellPct + '%';

      let bidsHtml = '';
      let asksHtml = '';
      for (let i = 1; i <= 5; i++) {
        const bidPrice = p - step * i;
        const askPrice = p + step * i;
        const bidQty = (Math.random() * 2.5 + 0.3).toFixed(2);
        const askQty = (Math.random() * 2.5 + 0.3).toFixed(2);
        const bidW = Math.min(100, Math.round(parseFloat(bidQty) * 34));
        const askW = Math.min(100, Math.round(parseFloat(askQty) * 34));

        bidsHtml += `
          <div class="relative flex justify-between px-1.5 py-0.5 rounded overflow-hidden">
            <div class="absolute right-0 top-0 bottom-0 bg-emerald-500/20" style="width:${bidW}%"></div>
            <span class="relative text-slate-300">${bidQty}</span>
            <span class="relative text-[#00e676] font-bold">${formatNum(bidPrice, dec)}</span>
          </div>`;

        asksHtml += `
          <div class="relative flex justify-between px-1.5 py-0.5 rounded overflow-hidden">
            <div class="absolute left-0 top-0 bottom-0 bg-red-500/20" style="width:${askW}%"></div>
            <span class="relative text-red-400 font-bold">${formatNum(askPrice, dec)}</span>
            <span class="relative text-slate-300">${askQty}</span>
          </div>`;
      }
      document.getElementById('obBidsList').innerHTML = bidsHtml;
      document.getElementById('obAsksList').innerHTML = asksHtml;
    }

    function renderPublicTradesModule() {
      if (!state.proModules.trades || state.activeTab !== 'terminal') return;
      const panel = document.getElementById('panel-trades');
      if (!panel.open) return;

      const asset = getCurrentAsset();
      const timeStr = new Date().toTimeString().split(' ')[0];
      const isBuy = Math.random() > 0.43;
      const qty = (Math.random() * 1.9 + 0.08).toFixed(3);

      state.publicTrades.unshift({
        time: timeStr,
        side: isBuy ? 'ACHAT' : 'VENTE',
        price: asset.price,
        decimals: asset.decimals,
        qty
      });
      if (state.publicTrades.length > 8) state.publicTrades.pop();

      document.getElementById('publicTradesList').innerHTML = state.publicTrades.map(t => `
        <div class="grid grid-cols-4 py-1 items-center">
          <span class="text-slate-400">${t.time}</span>
          <span class="${t.side === 'ACHAT' ? 'text-[#00e676]' : 'text-red-400'} font-bold">${t.side}</span>
          <span class="text-right text-white">${formatNum(t.price, t.decimals)}</span>
          <span class="text-right text-slate-300">${t.qty}</span>
        </div>
      `).join('');
    }

    function updateProRiskCalculator() {
      const cap = parseFloat(document.getElementById('calcBalanceInput').value) || state.balance;
      const riskPct = parseFloat(document.getElementById('calcRiskPct').value) || 1.0;
      const entry = parseFloat(document.getElementById('calcEntryPrice').value) || 1;
      const sl = parseFloat(document.getElementById('calcSlPrice').value) || 0.99;

      const maxLossUsd = cap * (riskPct / 100);
      const distRatio = Math.abs(entry - sl) / (entry || 1);
      const notional = distRatio > 0 ? maxLossUsd / distRatio : 0;
      const units = entry > 0 ? notional / entry : 0;

      document.getElementById('calcMaxLossUsd').textContent = `${formatNum(maxLossUsd, 2)} USDT`;
      document.getElementById('calcRecommendedSize').textContent = `Position : ${formatNum(notional, 2)} USDT • Qté : ${units.toFixed(4)} u.`;
    }

    function applyCalcToOrder() {
      const cap = parseFloat(document.getElementById('calcBalanceInput').value) || state.balance;
      const riskPct = parseFloat(document.getElementById('calcRiskPct').value) || 1.0;
      const entry = parseFloat(document.getElementById('calcEntryPrice').value) || getCurrentAsset().price;
      const sl = parseFloat(document.getElementById('calcSlPrice').value) || getCurrentAsset().sl;

      const maxLossUsd = cap * (riskPct / 100);
      const distRatio = Math.abs(entry - sl) / (entry || 1);
      const notional = distRatio > 0 ? maxLossUsd / distRatio : 250;
      const lev = parseInt(document.getElementById('orderLeverageSlider').value) || 3;
      const margin = Math.min(state.balance, Math.max(10, Math.round(notional / lev)));

      document.getElementById('orderMarginInput').value = margin;
      document.getElementById('orderEntryInput').value = entry;
      document.getElementById('orderSlInput').value = sl;
      validateAndCalculateOrder();
      showToast('Taille de position injectée dans le simulateur', '🧮');
    }

    function renderPriceAlerts() {
      const list = document.getElementById('priceAlertsList');
      if (!list) return;
      if (state.priceAlerts.length === 0) {
        list.innerHTML = `<div class="text-slate-400 text-xs py-1">Aucune alerte configurée.</div>`;
        return;
      }
      list.innerHTML = state.priceAlerts.map(a => `
        <div class="flex items-center justify-between px-3 py-2 rounded-xl bg-[#060c0b] border border-vx-border">
          <div class="flex items-center gap-2">
            <span class="text-purple-400">🔔</span>
            <span class="font-bold text-white">${a.symbol}</span>
            <span class="font-mono-num text-[#00e676]">Seuil : ${formatNum(a.price, 2)}</span>
          </div>
          <button onclick="removePriceAlert(${a.id})" class="text-slate-400 hover:text-red-400 text-xs font-bold">✕</button>
        </div>
      `).join('');
    }

    function addPriceAlert() {
      const val = parseFloat(document.getElementById('alertTargetPrice').value);
      if (!val || val <= 0) {
        showToast('Veuillez saisir un prix valide', '⚠️');
        return;
      }
      state.priceAlerts.push({
        id: Date.now(),
        symbol: state.activeSymbol,
        price: val,
        triggered: false
      });
      document.getElementById('alertTargetPrice').value = '';
      saveState();
      renderPriceAlerts();
      showToast(`Alerte activée sur ${state.activeSymbol} à ${formatNum(val, 2)}`, '🔔');
    }

    function removePriceAlert(id) {
      state.priceAlerts = state.priceAlerts.filter(a => a.id !== id);
      saveState();
      renderPriceAlerts();
    }

    // =========================================================================
    // 8. 60FPS CANVAS CHART + MANUAL FUTURE PROJECTION CONE (STEP-BY-STEP)
    // =========================================================================
    function stepFutureProjection(addSteps) {
      state.projectedSteps = Math.min(18, state.projectedSteps + addSteps);
      const badge = document.getElementById('projStatusBadge');
      const legend = document.getElementById('legendProjection');
      badge.textContent = `${state.projectedSteps} bougie(s) projetée(s)`;
      badge.className = 'font-mono-num text-[11px] px-2 py-0.5 rounded bg-emerald-950 text-[#00e676] border border-emerald-500/40 font-bold';
      legend.classList.remove('hidden');
      drawChart();
      showToast(`Projection IA avancée à +${state.projectedSteps} bougies futures`, '🔮');
    }

    function resetFutureProjection() {
      state.projectedSteps = 0;
      const badge = document.getElementById('projStatusBadge');
      const legend = document.getElementById('legendProjection');
      badge.textContent = '0 bougie projetée';
      badge.className = 'font-mono-num text-[11px] px-2 py-0.5 rounded bg-vx-card text-slate-300 border border-vx-border';
      legend.classList.add('hidden');
      drawChart();
    }

    function generateCandlesForAsset(asset) {
      const count = 44;
      const candles = [];
      let price = asset.price * 0.985;
      const volScale = asset.price * 0.0028;

      for (let i = 0; i < count; i++) {
        const open = price;
        const delta = (Math.random() - 0.46) * volScale;
        const close = Math.max(asset.price * 0.5, open + delta);
        const high = Math.max(open, close) + Math.random() * volScale * 0.65;
        const low = Math.min(open, close) - Math.random() * volScale * 0.65;
        const volume = Math.random() * 100 + 25;
        candles.push({ open, high, low, close, volume });
        price = close;
      }
      candles[candles.length - 1].close = asset.price;
      candles[candles.length - 1].high = Math.max(candles[candles.length - 1].high, asset.price);
      candles[candles.length - 1].low = Math.min(candles[candles.length - 1].low, asset.price);
      state.candles = candles;
    }

    function drawChart() {
      const canvas = document.getElementById('tradingCanvas');
      if (!canvas || state.activeTab !== 'terminal') return;
      const rect = canvas.parentElement.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) return;

      const dpr = window.devicePixelRatio || 1;
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      const ctx = canvas.getContext('2d');
      ctx.scale(dpr, dpr);

      const W = rect.width;
      const H = rect.height;
      const padRight = 76;
      const padBottom = 22;
      const padTop = 16;
      const chartW = W - padRight;
      const chartH = H - padBottom - padTop;

      ctx.clearRect(0, 0, W, H);

      const asset = getCurrentAsset();
      const candles = state.candles;
      if (!candles || candles.length === 0) return;

      // Calculate Linear Regression on last 14 candles for Manual Future Projection
      const projCount = state.projectedSteps;
      const projectedCandles = [];
      if (projCount > 0) {
        const lookback = Math.min(14, candles.length);
        const recent = candles.slice(-lookback);
        const biasSlope = asset.signal === 'ACHAT'
          ? (asset.tp - asset.price) / 14
          : (asset.tp - asset.price) / 14;
        let prevClose = candles[candles.length - 1].close;
        const stepVol = asset.price * 0.0018;

        for (let k = 1; k <= projCount; k++) {
          const expectedClose = prevClose + biasSlope * 0.65;
          const pOpen = prevClose;
          const pClose = expectedClose + ((k % 2 === 0 ? 1 : -0.4) * stepVol * 0.35);
          const pHigh = Math.max(pOpen, pClose) + stepVol * 0.5;
          const pLow = Math.min(pOpen, pClose) - stepVol * 0.5;
          const bandSpread = stepVol * (0.8 + k * 0.28);
          projectedCandles.push({
            open: pOpen,
            close: pClose,
            high: pHigh,
            low: pLow,
            upperBand: pClose + bandSpread,
            lowerBand: pClose - bandSpread
          });
          prevClose = pClose;
        }
      }

      let minP = Infinity;
      let maxP = -Infinity;
      let maxVol = 1;
      candles.forEach(c => {
        if (c.low < minP) minP = c.low;
        if (c.high > maxP) maxP = c.high;
        if (c.volume > maxVol) maxVol = c.volume;
      });

      projectedCandles.forEach(pc => {
        if (pc.lowerBand < minP) minP = pc.lowerBand;
        if (pc.upperBand > maxP) maxP = pc.upperBand;
      });

      if (state.showChartTpSl) {
        const entryVal = parseFloat(document.getElementById('orderEntryInput').value) || asset.entry;
        const slVal = parseFloat(document.getElementById('orderSlInput').value) || asset.sl;
        const tpVal = parseFloat(document.getElementById('orderTpInput').value) || asset.tp;
        minP = Math.min(minP, slVal, tpVal, entryVal);
        maxP = Math.max(maxP, slVal, tpVal, entryVal);
      }

      const range = (maxP - minP) || 1;
      minP -= range * 0.08;
      maxP += range * 0.08;
      const finalRange = maxP - minP;

      const priceToY = (p) => padTop + chartH - ((p - minP) / finalRange) * chartH;

      // Subtle Institutional Grid Lines (Horizontal & Vertical)
      ctx.strokeStyle = 'rgba(28, 48, 43, 0.45)';
      ctx.lineWidth = 1;
      ctx.fillStyle = '#94a3b8';
      ctx.font = '10px "JetBrains Mono", monospace';
      ctx.textAlign = 'left';

      const steps = 4;
      for (let i = 0; i <= steps; i++) {
        const y = padTop + (chartH / steps) * i;
        const pVal = maxP - (finalRange / steps) * i;
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(chartW, y);
        ctx.stroke();
        ctx.fillText(formatNum(pVal, asset.decimals), chartW + 6, y + 3);
      }

      for (let v = 1; v <= 4; v++) {
        const vx = (chartW / 5) * v;
        ctx.beginPath();
        ctx.moveTo(vx, padTop);
        ctx.lineTo(vx, padTop + chartH);
        ctx.stroke();
      }

      // Time labels at bottom
      ctx.fillStyle = '#64748b';
      ctx.fillText('15:00', chartW * 0.14, H - 6);
      ctx.fillText('16:30', chartW * 0.44, H - 6);
      ctx.fillText('Direct', chartW * 0.74, H - 6);

      const totalSlots = candles.length + projCount;
      const stepX = chartW / totalSlots;
      const bodyW = Math.max(3, stepX * 0.64);

      // Draw Volume Bars at bottom 18% of chart
      const volMaxH = chartH * 0.18;
      candles.forEach((c, idx) => {
        const x = idx * stepX + stepX / 2;
        const isBull = c.close >= c.open;
        const vH = (c.volume / maxVol) * volMaxH;
        ctx.fillStyle = isBull ? 'rgba(0, 230, 118, 0.16)' : 'rgba(239, 68, 68, 0.16)';
        ctx.fillRect(x - bodyW / 2, padTop + chartH - vH, bodyW, vH);
      });

      // Draw Historical Candlesticks (Refined wicks and crisp bodies)
      candles.forEach((c, idx) => {
        const x = idx * stepX + stepX / 2;
        const isBull = c.close >= c.open;
        ctx.strokeStyle = isBull ? '#00e676' : '#ef4444';
        ctx.fillStyle = isBull ? '#00e676' : '#ef4444';
        ctx.lineWidth = 1.15;

        ctx.beginPath();
        ctx.moveTo(x, priceToY(c.high));
        ctx.lineTo(x, priceToY(c.low));
        ctx.stroke();

        const yOpen = priceToY(c.open);
        const yClose = priceToY(c.close);
        const top = Math.min(yOpen, yClose);
        const height = Math.max(2, Math.abs(yClose - yOpen));
        ctx.fillRect(x - bodyW / 2, top, bodyW, height);
      });

      // Draw Manual Future Projection Cone & Ghost Candlesticks
      if (projectedCandles.length > 0) {
        const startIdx = candles.length - 1;
        const startX = startIdx * stepX + stepX / 2;
        const startY = priceToY(candles[startIdx].close);

        // Shaded Probability Cone
        ctx.save();
        ctx.fillStyle = asset.signal === 'ACHAT' ? 'rgba(0, 230, 118, 0.11)' : 'rgba(239, 68, 68, 0.11)';
        ctx.beginPath();
        ctx.moveTo(startX, startY);
        projectedCandles.forEach((pc, i) => {
          const px = (candles.length + i) * stepX + stepX / 2;
          ctx.lineTo(px, priceToY(pc.upperBand));
        });
        for (let i = projectedCandles.length - 1; i >= 0; i--) {
          const px = (candles.length + i) * stepX + stepX / 2;
          ctx.lineTo(px, priceToY(projectedCandles[i].lowerBand));
        }
        ctx.closePath();
        ctx.fill();

        // Linear Regression Center Dashed Line
        ctx.strokeStyle = '#00e676';
        ctx.setLineDash([4, 3]);
        ctx.lineWidth = 1.6;
        ctx.beginPath();
        ctx.moveTo(startX, startY);
        projectedCandles.forEach((pc, i) => {
          const px = (candles.length + i) * stepX + stepX / 2;
          ctx.lineTo(px, priceToY(pc.close));
        });
        ctx.stroke();
        ctx.restore();

        // Projected Future Candlesticks
        projectedCandles.forEach((pc, i) => {
          const x = (candles.length + i) * stepX + stepX / 2;
          const isBull = pc.close >= pc.open;
          ctx.save();
          ctx.strokeStyle = isBull ? 'rgba(0, 230, 118, 0.8)' : 'rgba(239, 68, 68, 0.8)';
          ctx.fillStyle = isBull ? 'rgba(0, 230, 118, 0.45)' : 'rgba(239, 68, 68, 0.45)';
          ctx.beginPath();
          ctx.moveTo(x, priceToY(pc.high));
          ctx.lineTo(x, priceToY(pc.low));
          ctx.stroke();

          const yOpen = priceToY(pc.open);
          const yClose = priceToY(pc.close);
          ctx.fillRect(x - bodyW / 2, Math.min(yOpen, yClose), bodyW, Math.max(2, Math.abs(yClose - yOpen)));
          ctx.restore();
        });
      }

      // Draw EMA 20, EMA 50 & VWAP
      if (state.showChartIndicators) {
        const drawEma = (period, color) => {
          ctx.strokeStyle = color;
          ctx.lineWidth = 1.6;
          ctx.beginPath();
          let ema = candles[0].close;
          const k = 2 / (period + 1);
          candles.forEach((c, idx) => {
            ema = c.close * k + ema * (1 - k);
            const x = idx * stepX + stepX / 2;
            const y = priceToY(ema);
            if (idx === 0) ctx.moveTo(x, y);
            else ctx.lineTo(x, y);
          });
          ctx.stroke();
        };
        drawEma(8, '#38bdf8');  // EMA 20
        drawEma(18, '#f59e0b'); // EMA 50
        drawEma(13, '#a855f7'); // VWAP
      }

      // Draw High-Contrast Entry, Stop-Loss & Take-Profit Lines + Right Axis Badges
      if (state.showChartTpSl) {
        const entryVal = parseFloat(document.getElementById('orderEntryInput').value) || asset.entry;
        const slVal = parseFloat(document.getElementById('orderSlInput').value) || asset.sl;
        const tpVal = parseFloat(document.getElementById('orderTpInput').value) || asset.tp;

        const drawLevel = (price, strokeCol, bgCol, textCol, label) => {
          const y = priceToY(price);
          if (y < padTop || y > padTop + chartH) return;
          ctx.save();
          ctx.strokeStyle = strokeCol;
          ctx.setLineDash([4, 4]);
          ctx.lineWidth = 1.25;
          ctx.beginPath();
          ctx.moveTo(0, y);
          ctx.lineTo(chartW, y);
          ctx.stroke();

          // Left pill tag
          ctx.fillStyle = bgCol;
          ctx.fillRect(6, y - 14, 98, 13);
          ctx.fillStyle = textCol;
          ctx.font = 'bold 9px "JetBrains Mono", monospace';
          ctx.fillText(label, 10, y - 4);
          ctx.restore();
        };

        drawLevel(tpVal, '#00e676', 'rgba(6, 78, 59, 0.92)', '#00e676', 'TP ' + formatNum(tpVal, asset.decimals));
        drawLevel(entryVal, '#38bdf8', 'rgba(12, 74, 110, 0.92)', '#7dd3fc', 'IN ' + formatNum(entryVal, asset.decimals));
        drawLevel(slVal, '#ef4444', 'rgba(127, 29, 29, 0.92)', '#fca5a5', 'SL ' + formatNum(slVal, asset.decimals));
      }

      // Current Live Price High-Contrast Tag on Right Axis
      const lastClose = candles[candles.length - 1].close;
      const curY = priceToY(lastClose);
      ctx.save();
      ctx.strokeStyle = '#00e676';
      ctx.setLineDash([2, 2]);
      ctx.beginPath();
      ctx.moveTo(0, curY);
      ctx.lineTo(chartW, curY);
      ctx.stroke();

      ctx.fillStyle = '#00e676';
      ctx.fillRect(chartW + 2, curY - 9, padRight - 4, 18);
      ctx.fillStyle = '#060c0b';
      ctx.font = 'extrabold 10px "JetBrains Mono", monospace';
      ctx.fillText(formatNum(lastClose, asset.decimals), chartW + 5, curY + 3.5);
      ctx.restore();
    }

    function setTimeframe(tf) {
      state.timeframe = tf;
      document.querySelectorAll('.tf-btn').forEach(btn => {
        if (btn.dataset.tf === tf) {
          btn.className = 'tf-btn px-2.5 py-1 rounded-lg text-xs font-bold bg-blue-950 text-blue-400 border border-blue-500/40';
        } else {
          btn.className = 'tf-btn px-2 py-1 rounded-lg text-xs font-semibold text-slate-400 hover:text-white';
        }
      });
      generateCandlesForAsset(getCurrentAsset());
      drawChart();
    }

    function toggleChartTpSl() {
      state.showChartTpSl = !state.showChartTpSl;
      const btn = document.getElementById('btnChartTpSl');
      btn.className = state.showChartTpSl
        ? 'px-2.5 py-1 rounded-lg text-xs font-semibold bg-emerald-950/80 text-emerald-300 border border-emerald-500/30 transition'
        : 'px-2.5 py-1 rounded-lg text-xs font-semibold bg-[#060c0b] text-slate-500 border border-vx-border transition';
      drawChart();
    }

    function toggleChartIndicators() {
      state.showChartIndicators = !state.showChartIndicators;
      const btn = document.getElementById('btnChartInd');
      btn.className = state.showChartIndicators
        ? 'px-2.5 py-1 rounded-lg text-xs font-semibold bg-[#0b1412] text-slate-200 border border-vx-border transition'
        : 'px-2.5 py-1 rounded-lg text-xs font-semibold bg-[#060c0b] text-slate-500 border border-vx-border transition';
      drawChart();
    }

    // =========================================================================
    // 9. ASSET SELECTION, LEVERAGE SYNC, RISK GAUGE & CONFIRMATION STEP
    // =========================================================================
    function syncLeverageFromSlider(val) {
      const lev = Math.min(100, Math.max(1, parseInt(val) || 1));
      document.getElementById('orderLeverageNumber').value = lev;
      cancelOrderConfirmation();
      validateAndCalculateOrder();
    }

    function syncLeverageFromNumber(val) {
      const lev = Math.min(100, Math.max(1, parseInt(val) || 1));
      document.getElementById('orderLeverageSlider').value = lev;
      cancelOrderConfirmation();
      validateAndCalculateOrder();
    }

    function selectAsset(symbol, loadSignalLevels = true) {
      const asset = ASSETS.find(a => a.symbol === symbol);
      if (!asset) return;
      state.activeSymbol = asset.symbol;
      state.projectedSteps = 0;

      const projBadge = document.getElementById('projStatusBadge');
      if (projBadge) {
        projBadge.textContent = '0 bougie projetée';
        projBadge.className = 'font-mono-num text-[11px] px-2 py-0.5 rounded bg-vx-card text-slate-300 border border-vx-border';
      }
      document.getElementById('legendProjection').classList.add('hidden');

      document.getElementById('quickBarSymbol').textContent = asset.symbol;
      document.getElementById('quickBarPrice').textContent = formatNum(asset.price, asset.decimals);

      document.getElementById('termAssetBadge').textContent = asset.short;
      document.getElementById('termAssetSymbol').textContent = asset.symbol;
      document.getElementById('termAssetCategory').textContent = asset.category.toUpperCase();
      document.getElementById('termAssetName').textContent = `${asset.name} • Hyperliquid`;
      document.getElementById('termFavBtn').textContent = asset.fav ? '★' : '☆';

      updateAssetLivePriceHeader(asset);

      const isBuy = asset.signal === 'ACHAT';
      const badge = document.getElementById('quantDirectionBadge');
      badge.textContent = isBuy ? '↗ ACHAT' : '↘ VENTE';
      badge.className = isBuy
        ? 'px-3 py-1.5 rounded-xl bg-emerald-950/90 border border-emerald-500/40 text-[#00e676] font-extrabold text-xs tracking-wide'
        : 'px-3 py-1.5 rounded-xl bg-red-950/90 border border-red-500/40 text-red-400 font-extrabold text-xs tracking-wide';

      document.getElementById('quantConfidenceTxt').textContent = asset.conf + ' %';
      const confBar = document.getElementById('quantConfidenceBar');
      confBar.style.width = asset.conf + '%';
      confBar.className = `h-full ${isBuy ? 'bg-[#00e676]' : 'bg-red-500'} rounded-full transition-all duration-500`;

      document.getElementById('quantEntry').textContent = formatNum(asset.entry, asset.decimals);
      document.getElementById('quantSl').textContent = formatNum(asset.sl, asset.decimals);
      document.getElementById('quantTp').textContent = formatNum(asset.tp, asset.decimals);
      document.getElementById('quantScore').textContent = isBuy ? '+4.2' : '-3.9';
      document.getElementById('quantNewsBias').textContent = isBuy ? 'Sentiment News : Haussier' : 'Sentiment News : Prudent';

      // Update structured indicator blocks under chart
      document.getElementById('indRsiVal').textContent = isBuy ? '56.2 • Haussier' : '42.8 • Baissier';
      const macdEl = document.getElementById('indMacdVal');
      macdEl.textContent = isBuy ? '+184.09 • Croisement ↗' : '-92.40 • Croisement ↘';
      macdEl.className = `font-mono-num font-extrabold text-xs mt-0.5 ${isBuy ? 'text-[#00e676]' : 'text-red-400'}`;

      // Sync Risk Calculator inputs with current asset
      document.getElementById('calcEntryPrice').value = asset.entry;
      document.getElementById('calcSlPrice').value = asset.sl;
      document.getElementById('calcBalanceInput').value = state.balance.toFixed(2);
      updateProRiskCalculator();

      if (loadSignalLevels) {
        setOrderSide(isBuy ? 'LONG' : 'SHORT');
        document.getElementById('orderEntryInput').value = asset.entry;
        document.getElementById('orderSlInput').value = asset.sl;
        document.getElementById('orderTpInput').value = asset.tp;
      }

      cancelOrderConfirmation();
      generateCandlesForAsset(asset);
      validateAndCalculateOrder();
      renderTerminalWatchlist();
      drawChart();
    }

    function updateAssetLivePriceHeader(asset) {
      document.getElementById('termAssetPrice').textContent = formatNum(asset.price, asset.decimals);
      const diffVal = asset.price * (asset.changePct / 100);
      const sign = asset.changePct >= 0 ? '+' : '';
      const changeEl = document.getElementById('termAssetChange');
      changeEl.textContent = `${sign}${formatNum(diffVal, asset.decimals)} • ${sign}${asset.changePct.toFixed(2)} % / 24 h`;
      changeEl.className = `font-mono-num text-xs font-semibold ${asset.changePct >= 0 ? 'text-[#00e676]' : 'text-red-400'}`;
    }

    function toggleFavoriteCurrent() {
      const asset = getCurrentAsset();
      asset.fav = !asset.fav;
      document.getElementById('termFavBtn').textContent = asset.fav ? '★' : '☆';
      renderTerminalWatchlist();
      showToast(asset.fav ? `${asset.symbol} ajouté aux favoris` : `${asset.symbol} retiré des favoris`, '★');
    }

    function useQuantSignalInOrder() {
      const asset = getCurrentAsset();
      setOrderSide(asset.signal === 'ACHAT' ? 'LONG' : 'SHORT');
      document.getElementById('orderEntryInput').value = asset.entry;
      document.getElementById('orderSlInput').value = asset.sl;
      document.getElementById('orderTpInput').value = asset.tp;
      cancelOrderConfirmation();
      validateAndCalculateOrder();
      drawChart();
      document.getElementById('orderSimulatorCard').scrollIntoView({ behavior: 'smooth' });
      showToast(`Signal ${asset.symbol} appliqué au simulateur d'ordre`, '⚡');
    }

    function setOrderSide(side) {
      state.orderSide = side;
      const btnLong = document.getElementById('btnSideLong');
      const btnShort = document.getElementById('btnSideShort');
      if (side === 'LONG') {
        btnLong.className = 'py-3 rounded-xl font-extrabold text-sm border transition bg-emerald-950/90 border-emerald-500 text-[#00e676] shadow-inner';
        btnShort.className = 'py-3 rounded-xl font-extrabold text-sm border transition bg-[#060c0b] border-vx-border text-slate-400 hover:text-white';
      } else {
        btnShort.className = 'py-3 rounded-xl font-extrabold text-sm border transition bg-red-950/90 border-red-500 text-red-300 shadow-inner';
        btnLong.className = 'py-3 rounded-xl font-extrabold text-sm border transition bg-[#060c0b] border-vx-border text-slate-400 hover:text-white';
      }
      cancelOrderConfirmation();
      validateAndCalculateOrder();
    }

    function setMarginPercent(pct) {
      const target = Math.max(10, Math.floor(state.balance * pct));
      document.getElementById('orderMarginInput').value = target;
      cancelOrderConfirmation();
      validateAndCalculateOrder();
    }

    function validateAndCalculateOrder() {
      const asset = getCurrentAsset();
      const margin = parseFloat(document.getElementById('orderMarginInput').value) || 0;
      const lev = parseInt(document.getElementById('orderLeverageSlider').value) || 1;
      const entry = parseFloat(document.getElementById('orderEntryInput').value) || 0;
      const sl = parseFloat(document.getElementById('orderSlInput').value) || 0;
      const tp = parseFloat(document.getElementById('orderTpInput').value) || 0;

      document.getElementById('orderLeverageNumber').value = lev;

      const positionNotional = margin * lev;
      const dynamicUnits = entry > 0 ? positionNotional / entry : 0;
      document.getElementById('dynamicUnitsPreview').textContent = `Qté dyn. : ${dynamicUnits.toFixed(4)} ${asset.short}`;

      const isLong = state.orderSide === 'LONG';

      const slDistRatio = entry > 0 ? Math.abs(entry - sl) / entry : 0;
      const tpDistRatio = entry > 0 ? Math.abs(tp - entry) / entry : 0;

      const maxRiskUsd = positionNotional * slDistRatio;
      const targetGainUsd = positionNotional * tpDistRatio;
      const rrRatio = maxRiskUsd > 0 ? targetGainUsd / maxRiskUsd : 0;

      const liqPrice = isLong
        ? Math.max(0, entry * (1 - (1 / lev) * 0.95))
        : entry * (1 + (1 / lev) * 0.95);

      document.getElementById('simPositionSize').textContent = `${formatNum(positionNotional, 0)} USDT`;
      document.getElementById('simMaxRisk').textContent = `-${formatNum(maxRiskUsd, 1)} USDT`;
      document.getElementById('simTargetGain').textContent = `+${formatNum(targetGainUsd, 1)} USDT`;
      document.getElementById('simLiqPrice').textContent = formatNum(liqPrice, asset.decimals);

      // Update Global Risk Level Gauge
      const riskPctOfBalance = state.balance > 0 ? (maxRiskUsd / state.balance) * 100 : 100;
      const riskGaugeBar = document.getElementById('globalRiskBar');
      const riskGaugeBadge = document.getElementById('globalRiskBadge');
      const barWidth = Math.min(100, Math.max(5, (riskPctOfBalance / (state.guardrails.maxRiskPct * 1.5)) * 100));
      riskGaugeBar.style.width = `${barWidth}%`;

      if (riskPctOfBalance <= state.guardrails.maxRiskPct * 0.6) {
        riskGaugeBadge.textContent = `Faible • ${riskPctOfBalance.toFixed(2)}% du capital`;
        riskGaugeBadge.className = 'font-mono-num font-extrabold text-[#00e676]';
        riskGaugeBar.className = 'h-full bg-[#00e676] transition-all duration-300';
      } else if (riskPctOfBalance <= state.guardrails.maxRiskPct) {
        riskGaugeBadge.textContent = `Modéré • ${riskPctOfBalance.toFixed(2)}% du capital`;
        riskGaugeBadge.className = 'font-mono-num font-extrabold text-amber-400';
        riskGaugeBar.className = 'h-full bg-amber-400 transition-all duration-300';
      } else {
        riskGaugeBadge.textContent = `Critique • ${riskPctOfBalance.toFixed(2)}% (Dépasse ${state.guardrails.maxRiskPct}%)`;
        riskGaugeBadge.className = 'font-mono-num font-extrabold text-red-400';
        riskGaugeBar.className = 'h-full bg-red-500 transition-all duration-300';
      }

      // 8 Real-time Risk Firewall Rules
      const valuesValid = margin > 0 && entry > 0 && sl > 0 && tp > 0;
      const balanceOk = margin <= state.balance;
      const levOk = lev <= 100;
      const sidePlacementOk = isLong ? (sl < entry && tp > entry) : (sl > entry && tp < entry);
      const rrOk = rrRatio >= state.guardrails.minRR;
      const riskPctOk = riskPctOfBalance <= state.guardrails.maxRiskPct;
      const projectedDrawdownPct = riskPctOfBalance * 2.25;
      const drawdownOk = projectedDrawdownPct <= state.guardrails.maxDrawdownPct;
      const openPosCountOk = state.openPositions.length < state.guardrails.maxPositions;

      const checks = [
        { ok: valuesValid, text: 'Toutes les valeurs sont valides' },
        { ok: balanceOk, text: `${formatNum(margin, 2)} USDT sur ${formatNum(state.balance, 2)} USDT disponibles` },
        { ok: levOk, text: `x${lev} (maximum x100)` },
        { ok: sidePlacementOk, text: `Placés du bon côté du prix d'entrée` },
        { ok: rrOk, text: `Ratio 1 : ${rrRatio.toFixed(2)} (minimum 1 : ${state.guardrails.minRR.toFixed(1)})` },
        { ok: riskPctOk, text: `${riskPctOfBalance.toFixed(2)} % du solde (maximum ${state.guardrails.maxRiskPct} %)` },
        { ok: drawdownOk, text: `Drawdown projeté ${projectedDrawdownPct.toFixed(2)} % (limite ${state.guardrails.maxDrawdownPct} %)` },
        { ok: openPosCountOk, text: `${state.openPositions.length} ouverte(s) sur ${state.guardrails.maxPositions} autorisées` }
      ];

      const listEl = document.getElementById('riskChecklist');
      listEl.innerHTML = checks.map(c => `
        <li class="flex items-center gap-2 ${c.ok ? 'text-slate-200' : 'text-red-400 font-bold'}">
          <span class="${c.ok ? 'text-[#00e676]' : 'text-red-400'}">${c.ok ? '✓' : '✕'}</span>
          <span>${c.text}</span>
        </li>
      `).join('');

      const failedCheck = checks.find(c => !c.ok);
      const banner = document.getElementById('firewallBanner');
      const btn = document.getElementById('btnSubmitOrder');
      const modeLabel = state.executionMode === 'LIVE' ? 'Hyperliquid Live' : 'Paper';

      if (failedCheck) {
        banner.classList.remove('hidden');
        banner.textContent = `Ordre bloqué par le pare-feu : ${failedCheck.text}.`;
        btn.disabled = true;
      } else {
        banner.classList.add('hidden');
        btn.disabled = false;
      }

      btn.textContent = `⚡ Ouvrir ${isLong ? 'Long' : 'Short'} • ${modeLabel}`;
      btn.className = isLong
        ? 'w-full py-4 rounded-xl bg-gradient-to-r from-emerald-500 via-[#00e676] to-teal-400 hover:brightness-110 disabled:opacity-40 disabled:cursor-not-allowed text-black font-extrabold text-sm tracking-wider uppercase transition shadow-[0_0_20px_rgba(0,230,118,0.35)] border border-emerald-300/50'
        : 'w-full py-4 rounded-xl bg-gradient-to-r from-red-600 via-red-500 to-rose-500 hover:brightness-110 disabled:opacity-40 disabled:cursor-not-allowed text-white font-extrabold text-sm tracking-wider uppercase transition shadow-[0_0_20px_rgba(239,68,68,0.35)] border border-red-400/50';

      if (state.showChartTpSl && state.activeTab === 'terminal') {
        drawChart();
      }
    }

    function executeSimulatedOrLiveOrder() {
      const requireConfirm = document.getElementById('chkConfirmBeforeExec').checked;
      const confirmBox = document.getElementById('orderConfirmBox');

      if (requireConfirm && confirmBox.classList.contains('hidden')) {
        const asset = getCurrentAsset();
        const margin = parseFloat(document.getElementById('orderMarginInput').value) || 0;
        const lev = parseInt(document.getElementById('orderLeverageSlider').value) || 1;
        const entry = parseFloat(document.getElementById('orderEntryInput').value) || asset.price;
        const sl = parseFloat(document.getElementById('orderSlInput').value);
        const tp = parseFloat(document.getElementById('orderTpInput').value);

        document.getElementById('confirmBoxSummary').textContent = `${state.orderSide} ${asset.symbol} (x${lev})`;
        document.getElementById('confirmBoxDetails').textContent = `Marge : ${formatNum(margin, 0)} USDT • Position : ${formatNum(margin * lev, 0)} USDT • Entrée : ${formatNum(entry, asset.decimals)} • SL : ${formatNum(sl, asset.decimals)} • TP : ${formatNum(tp, asset.decimals)}`;
        confirmBox.classList.remove('hidden');
        return;
      }

      finalizeOrderExecution();
    }

    function cancelOrderConfirmation() {
      const confirmBox = document.getElementById('orderConfirmBox');
      if (confirmBox) confirmBox.classList.add('hidden');
    }

    function finalizeOrderExecution() {
      cancelOrderConfirmation();
      const asset = getCurrentAsset();
      const margin = parseFloat(document.getElementById('orderMarginInput').value) || 0;
      const lev = parseInt(document.getElementById('orderLeverageSlider').value) || 1;
      const entry = parseFloat(document.getElementById('orderEntryInput').value) || asset.price;
      const sl = parseFloat(document.getElementById('orderSlInput').value);
      const tp = parseFloat(document.getElementById('orderTpInput').value);

      if (margin > state.balance) return;

      state.balance -= margin;
      state.openPositions.unshift({
        id: Date.now(),
        symbol: asset.symbol,
        decimals: asset.decimals,
        side: state.orderSide,
        lev,
        margin,
        notional: margin * lev,
        entry,
        sl,
        tp,
        openedAt: new Date().toTimeString().slice(0, 5)
      });

      saveState();
      validateAndCalculateOrder();
      renderPortfolioTab();
      showToast(`Position ${state.orderSide} ouverte sur ${asset.symbol} (${formatNum(margin, 0)} USDT x${lev})`, '🚀');
    }

    // =========================================================================
    // 10. WATCHLIST & 32-ASSET CATALOGUE MODAL
    // =========================================================================
    function setWatchlistFilter(cat) {
      state.watchlistFilter = cat;
      document.querySelectorAll('.wcat-btn').forEach(btn => {
        if (btn.dataset.wcat === cat) {
          btn.className = 'wcat-btn shrink-0 px-3 py-1 rounded-xl text-xs font-bold bg-blue-950 text-blue-400 border border-blue-500/30';
        } else {
          btn.className = 'wcat-btn shrink-0 px-3 py-1 rounded-xl text-xs font-semibold bg-[#060c0b] text-slate-400 border border-vx-border';
        }
      });
      renderTerminalWatchlist();
    }

    function renderTerminalWatchlist() {
      const grid = document.getElementById('terminalWatchlistGrid');
      if (!grid) return;

      const filtered = ASSETS.filter(a => {
        if (state.watchlistFilter === 'Tous') return true;
        if (state.watchlistFilter === 'Favoris') return a.fav;
        return a.category === state.watchlistFilter;
      }).slice(0, 8);

      grid.innerHTML = filtered.map(a => {
        const isPos = a.changePct >= 0;
        return `
          <div onclick="selectAsset('${a.symbol}', true)" class="p-3 rounded-xl bg-[#060c0b] hover:bg-[#0b1412] border ${a.symbol === state.activeSymbol ? 'border-emerald-500/60' : 'border-vx-border'} cursor-pointer transition flex items-center justify-between gap-2">
            <div class="flex items-center gap-2 min-w-0">
              <div class="w-8 h-8 shrink-0 rounded-lg bg-[#101d1a] border border-vx-border flex items-center justify-center font-bold text-xs text-white">${a.short}</div>
              <div class="truncate">
                <div class="font-extrabold text-xs text-white truncate">${a.symbol}</div>
                <div class="text-[10px] text-slate-400 uppercase truncate">${a.category}</div>
              </div>
            </div>
            <div class="text-right shrink-0">
              <div class="font-mono-num font-bold text-xs text-white">${formatNum(a.price, a.decimals)}</div>
              <div class="font-mono-num text-[11px] font-semibold ${isPos ? 'text-[#00e676]' : 'text-red-400'}">${isPos ? '+' : ''}${a.changePct.toFixed(2)}%</div>
            </div>
          </div>
        `;
      }).join('');
    }

    function openCatalogModal() {
      document.getElementById('catalogModal').classList.remove('hidden');
      renderCatalogModalList();
    }

    function closeCatalogModal() {
      document.getElementById('catalogModal').classList.add('hidden');
    }

    function renderCatalogModalList() {
      const q = (document.getElementById('catalogSearchInput').value || '').toLowerCase();
      const list = document.getElementById('catalogModalList');
      const items = ASSETS.filter(a =>
        a.symbol.toLowerCase().includes(q) ||
        a.name.toLowerCase().includes(q) ||
        a.category.toLowerCase().includes(q)
      );

      list.innerHTML = items.map(a => `
        <div onclick="selectAsset('${a.symbol}', true); closeCatalogModal(); switchTab('terminal');" class="p-2.5 rounded-xl hover:bg-vx-card cursor-pointer flex items-center justify-between transition">
          <div class="flex items-center gap-2.5">
            <span class="w-8 h-8 rounded-lg bg-vx-card border border-vx-border flex items-center justify-center font-bold text-xs text-emerald-400">${a.short}</span>
            <div>
              <div class="font-bold text-xs text-white">${a.symbol} <span class="text-[10px] text-slate-400 ml-1">${a.category}</span></div>
              <div class="text-[11px] text-slate-400">${a.name}</div>
            </div>
          </div>
          <div class="text-right font-mono-num">
            <div class="text-xs font-bold text-white">${formatNum(a.price, a.decimals)}</div>
            <div class="text-[10px] ${a.signal === 'ACHAT' ? 'text-[#00e676]' : 'text-red-400'}">${a.signal} (${a.conf}%)</div>
          </div>
        </div>
      `).join('');
    }

    // =========================================================================
    // 11. TAB 2: SIGNAUX IA SCANNER (HIGH-CONTRAST CARDS)
    // =========================================================================
    function filterSignals(cat) {
      state.signalsFilter = cat;
      document.querySelectorAll('.scat-btn').forEach(btn => {
        if (btn.dataset.scat === cat) {
          btn.className = 'scat-btn px-3.5 py-1.5 rounded-xl text-xs font-extrabold bg-emerald-950 text-[#00e676] border border-emerald-500/40';
        } else {
          btn.className = 'scat-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-[#060c0b] text-slate-300 border border-vx-border';
