    // =========================================================================
    // 4. PERSISTENT APPLICATION STATE
    // =========================================================================
    const DEFAULT_HISTORY = [
      { symbol: 'BTC-USDT', side: 'LONG', lev: 10, reason: 'Stop-Loss touché', time: '18:25', pnl: -55.69 },
      { symbol: 'SOL-USDT', side: 'LONG', lev: 10, reason: 'TP atteint', time: '12:45', pnl: 142.80 },
