
<!DOCTYPE html>
<html lang="fr" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="theme-color" content="#060c0b" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <title>Vertex MASTER V2 — Terminal Quantitatif Multi-Actifs</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            vx: {
              bg: '#060c0b',
              surface: '#0b1412',
              card: '#101d1a',
              cardHover: '#152723',
              border: '#1c302b',
              emerald: '#10b981',
              neon: '#00e676',
              red: '#ef4444',
              amber: '#f59e0b',
              blue: '#3b82f6',
              muted: '#8da39e'
            }
          }
        }
      }
    }
  </script>
  <style>
    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }
    body {
      background-color: #060c0b;
      color: #f1f5f9;
      font-family: 'Inter', sans-serif;
      overflow-x: hidden;
      padding-bottom: 88px;
      user-select: none;
    }
    .font-mono-num {
      font-family: 'JetBrains Mono', monospace;
      font-variant-numeric: tabular-nums;
    }
    ::-webkit-scrollbar {
      width: 4px;
      height: 4px;
    }
    ::-webkit-scrollbar-track {
      background: #060c0b;
    }
    ::-webkit-scrollbar-thumb {
      background: #1c302b;
      border-radius: 9999px;
    }
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    input[type=range] {
      -webkit-appearance: none;
      appearance: none;
      background: transparent;
      cursor: pointer;
    }
    input[type=range]::-webkit-slider-runnable-track {
      background: #1c302b;
      height: 6px;
      border-radius: 999px;
    }
    input[type=range]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      margin-top: -5px;
      background-color: #00e676;
      height: 16px;
      width: 16px;
      border-radius: 50%;
      border: 2px solid #060c0b;
      box-shadow: 0 0 10px rgba(0, 230, 118, 0.65);
    }
    @keyframes pulseDot {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.85); }
    }
    .pulse-dot {
      animation: pulseDot 1.8s infinite ease-in-out;
    }
    .glass-header {
      background: rgba(6, 12, 11, 0.94);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
    .glass-nav {
      background: rgba(11, 20, 18, 0.96);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
    }
  </style>
</head>
<body class="min-h-screen antialiased selection:bg-emerald-500 selection:text-black">

  <!-- ==================== TOP STICKY HEADER & QUICK BAR ==================== -->
  <header class="sticky top-0 z-40 glass-header border-b border-vx-border px-3 py-2.5">
    <div class="max-w-3xl mx-auto flex flex-col gap-2">
      
      <!-- Row 1: Brand + Master V2 Badge + WebSocket Status Pill -->
      <div class="flex items-center justify-between gap-2">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-full bg-emerald-950/90 border border-emerald-500/40 flex items-center justify-center text-emerald-400 font-extrabold text-sm tracking-wider shadow-inner">
            VX
          </div>
          <span class="font-extrabold text-lg tracking-tight text-white">Vertex</span>
          <span class="px-2.5 py-0.5 text-[11px] font-bold tracking-wider uppercase rounded-lg bg-[#101d1a] text-slate-300 border border-vx-border">
            MASTER V2
          </span>
        </div>

        <!-- Hyperliquid WebSocket & Mode Status Indicator -->
        <button onclick="switchTab('portfolio')" id="headerWsBadge" class="flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-[#101d1a] text-emerald-400 border border-emerald-500/30 hover:border-emerald-400 transition">
          <span class="w-2 h-2 rounded-full bg-emerald-400 pulse-dot"></span>
          <span id="headerModeText">Hyperliquid • WebSocket</span>
        </button>
      </div>

      <!-- Row 2: Live Latency + Prompt IA + Mettre sur mon téléphone -->
      <div class="flex flex-wrap items-center gap-2">
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-[#0b1412] border border-emerald-500/30 text-xs font-medium text-slate-200">
          <span class="w-2 h-2 rounded-full bg-[#00e676] pulse-dot"></span>
          <span>Flux en direct</span>
          <span id="latencyBadge" class="font-mono-num text-[#00e676] font-bold">18ms</span>
        </div>

        <button onclick="openAiPromptModal()" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[#101d1a] hover:bg-vx-cardHover border border-vx-border text-xs font-semibold text-slate-100 transition active:scale-95">
          <span class="text-amber-400">✨</span>
          <span>Prompt IA</span>
        </button>

        <button onclick="openPwaModal()" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-950/80 hover:bg-emerald-900/80 border border-emerald-500/40 text-xs font-semibold text-emerald-300 transition active:scale-95">
          <span>📲</span>
          <span>Mettre sur mon téléphone</span>
        </button>
      </div>

      <!-- Row 3: Quick Action Bar (Watchlist, Active Ticker, Catalogue 32, Outils Pro) -->
      <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar pt-0.5">
        <button onclick="jumpToWatchlist()" class="shrink-0 flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-amber-950/40 hover:bg-amber-900/50 border border-amber-500/30 text-amber-300 text-xs font-semibold transition">
          <span>★</span>
          <span>Watchlist</span>
        </button>

        <button onclick="openCatalogModal()" class="shrink-0 flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[#101d1a] hover:bg-vx-cardHover border border-vx-border text-xs font-bold text-white transition">
          <span class="text-amber-400">★</span>
          <span id="quickBarSymbol">BTC-USDT</span>
          <span id="quickBarPrice" class="font-mono-num text-[#00e676]">64 266,5</span>
          <span class="text-slate-400 text-[10px]">▾</span>
        </button>

        <button onclick="openCatalogModal()" class="shrink-0 flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-blue-950/50 hover:bg-blue-900/60 border border-blue-500/30 text-blue-300 text-xs font-semibold transition">
          <span>Catalogue (<span id="catalogCount">32</span>)</span>
          <span>▾</span>
        </button>

        <button onclick="toggleProSubmenu()" id="proMenuBtn" class="shrink-0 flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-[#101d1a] hover:bg-vx-cardHover border border-emerald-500/30 text-emerald-300 text-xs font-semibold transition">
          <span>⚙️ Outils Pro</span>
          <span id="proActiveCount" class="px-1.5 py-0.2 rounded-md bg-emerald-500/20 text-emerald-300 font-mono-num text-[10px]">0</span>
          <span>▾</span>
        </button>
      </div>

      <!-- Retractable Pro Tools Sub-Menu (Opt-in Checkboxes) -->
      <div id="proSubmenuDrawer" class="hidden rounded-2xl bg-[#0b1412] border border-emerald-500/40 p-3.5 text-xs space-y-2.5 shadow-2xl">
        <div class="flex items-center justify-between border-b border-vx-border pb-2">
          <div>
            <span class="font-extrabold text-white uppercase tracking-wider text-[11px]">⚙️ Sous-menu Outils Pro (Activation à la demande)</span>
            <p class="text-[11px] text-slate-400">Cochez uniquement les outils souhaités : zéro consommation CPU lorsqu'ils sont masqués.</p>
          </div>
          <button onclick="toggleProSubmenu()" class="text-slate-400 hover:text-white px-2 py-1 text-xs font-bold">Fermer ✕</button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <label class="flex items-center justify-between p-2.5 rounded-xl bg-vx-card border border-vx-border hover:border-emerald-500/50 cursor-pointer transition">
            <div class="flex items-center gap-2.5">
              <input type="checkbox" id="chkOrderbook" onchange="toggleProModule('orderbook', this.checked)" class="w-4 h-4 accent-emerald-500 rounded cursor-pointer" />
              <div>
                <div class="font-bold text-slate-100">Carnet d'ordres en temps réel</div>
                <div class="text-[10px] text-slate-400">Profondeur L2 & Pression Acheteurs/Vendeurs</div>
              </div>
            </div>
            <span class="text-[10px] font-mono-num px-1.5 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-500/20">L2</span>
          </label>

          <label class="flex items-center justify-between p-2.5 rounded-xl bg-vx-card border border-vx-border hover:border-emerald-500/50 cursor-pointer transition">
            <div class="flex items-center gap-2.5">
              <input type="checkbox" id="chkTrades" onchange="toggleProModule('trades', this.checked)" class="w-4 h-4 accent-emerald-500 rounded cursor-pointer" />
              <div>
                <div class="font-bold text-slate-100">Flux des transactions publiques</div>
                <div class="text-[10px] text-slate-400">Time & Sales (Exécutions marché en direct)</div>
              </div>
            </div>
            <span class="text-[10px] font-mono-num px-1.5 py-0.5 rounded bg-blue-950 text-blue-400 border border-blue-500/20">Flux</span>
          </label>

          <label class="flex items-center justify-between p-2.5 rounded-xl bg-vx-card border border-vx-border hover:border-emerald-500/50 cursor-pointer transition">
            <div class="flex items-center gap-2.5">
              <input type="checkbox" id="chkRiskCalc" onchange="toggleProModule('riskcalc', this.checked)" class="w-4 h-4 accent-emerald-500 rounded cursor-pointer" />
              <div>
                <div class="font-bold text-slate-100">Calculateur de taille de position</div>
                <div class="text-[10px] text-slate-400">Calibrage précis selon Capital, Risque %, Entrée & SL</div>
              </div>
            </div>
            <span class="text-[10px] font-mono-num px-1.5 py-0.5 rounded bg-amber-950 text-amber-400 border border-amber-500/20">Risque</span>
          </label>

          <label class="flex items-center justify-between p-2.5 rounded-xl bg-vx-card border border-vx-border hover:border-emerald-500/50 cursor-pointer transition">
            <div class="flex items-center gap-2.5">
              <input type="checkbox" id="chkAlerts" onchange="toggleProModule('alerts', this.checked)" class="w-4 h-4 accent-emerald-500 rounded cursor-pointer" />
              <div>
                <div class="font-bold text-slate-100">Alertes de prix personnalisables</div>
                <div class="text-[10px] text-slate-400">Surveillance de seuils avec déclenchement</div>
              </div>
            </div>
            <span class="text-[10px] font-mono-num px-1.5 py-0.5 rounded bg-purple-950 text-purple-300 border border-purple-500/20">Alerte</span>
          </label>
        </div>
      </div>

    </div>
  </header>

  <!-- ==================== MAIN CONTENT CONTAINER ==================== -->
  <main class="max-w-3xl mx-auto px-3 pt-3 space-y-4">

    <!-- Toast Notification Banner -->
    <div id="toastBanner" class="hidden fixed top-28 left-1/2 -translate-x-1/2 z-50 max-w-sm w-[92%] px-4 py-3 rounded-2xl bg-[#101d1a] border border-emerald-500/60 text-white shadow-2xl flex items-center justify-between gap-3 transition-all">
      <div class="flex items-center gap-2.5 text-xs font-semibold">
        <span id="toastIcon" class="text-base">⚡</span>
        <span id="toastMessage">Action exécutée</span>
      </div>
      <button onclick="hideToast()" class="text-slate-400 hover:text-white text-xs font-bold">✕</button>
    </div>

    <!-- ===================================================================
         TAB 1 : TERMINAL
         =================================================================== -->
    <section id="tab-terminal" class="space-y-4">

      <!-- 1. ON-DEMAND RETRACTABLE PRO MODULES CONTAINER -->
      <div id="proModulesContainer" class="space-y-3 hidden">
        
        <!-- Pro Module 1: L2 Order Book & Buyer/Seller Pressure Gauge -->
        <details id="panel-orderbook" class="hidden group rounded-2xl bg-vx-card border border-vx-border overflow-hidden shadow-lg" open>
          <summary class="flex items-center justify-between px-4 py-3 cursor-pointer select-none bg-[#0b1412] hover:bg-vx-cardHover transition">
            <div class="flex items-center gap-2">
              <span class="text-emerald-400 font-extrabold text-xs sm:text-sm">📊 Carnet d'ordres en temps réel (Order Book L2)</span>
              <span class="px-2 py-0.5 text-[10px] font-mono-num rounded bg-emerald-950 text-emerald-300 border border-emerald-500/30">Pression Live</span>
            </div>
            <span class="text-xs text-slate-400 group-open:rotate-180 transition-transform">▾</span>
          </summary>
          <div class="p-3.5 space-y-3 border-t border-vx-border">
            <!-- Visual Buyer / Seller Pressure Gauge -->
            <div class="space-y-1.5">
              <div class="flex items-center justify-between text-xs font-bold">
                <span class="text-emerald-400" id="obBuyPressureTxt">64% Acheteurs</span>
                <span class="text-slate-400 font-mono-num text-[11px]" id="obSpreadTxt">Spread : 0,50 USDT</span>
                <span class="text-red-400" id="obSellPressureTxt">36% Vendeurs</span>
              </div>
              <div class="w-full h-2.5 rounded-full bg-red-950/80 overflow-hidden flex p-0.5 border border-vx-border">
                <div id="obBuyBar" class="h-full bg-[#00e676] rounded-l-full transition-all duration-300" style="width: 64%"></div>
                <div id="obSellBar" class="h-full bg-red-500 rounded-r-full transition-all duration-300" style="width: 36%"></div>
              </div>
            </div>

            <!-- Bids & Asks L2 Depth Bars -->
            <div class="grid grid-cols-2 gap-3 text-xs font-mono-num">
              <div>
                <div class="flex justify-between text-[10px] text-slate-400 uppercase pb-1 border-b border-vx-border">
                  <span>Taille (Bids)</span>
                  <span>Prix Achat</span>
                </div>
                <div id="obBidsList" class="space-y-1 pt-1"></div>
              </div>
              <div>
                <div class="flex justify-between text-[10px] text-slate-400 uppercase pb-1 border-b border-vx-border">
                  <span>Prix Vente</span>
                  <span>Taille (Asks)</span>
                </div>
                <div id="obAsksList" class="space-y-1 pt-1"></div>
              </div>
            </div>
          </div>
        </details>

        <!-- Pro Module 2: Public Trades (Time & Sales) -->
        <details id="panel-trades" class="hidden group rounded-2xl bg-vx-card border border-vx-border overflow-hidden shadow-lg" open>
          <summary class="flex items-center justify-between px-4 py-3 cursor-pointer select-none bg-[#0b1412] hover:bg-vx-cardHover transition">
            <div class="flex items-center gap-2">
              <span class="text-blue-400 font-extrabold text-xs sm:text-sm">⚡ Flux des transactions publiques (Time & Sales)</span>
            </div>
            <span class="text-xs text-slate-400 group-open:rotate-180 transition-transform">▾</span>
          </summary>
          <div class="p-3.5 border-t border-vx-border">
            <div class="grid grid-cols-4 text-[10px] text-slate-400 uppercase pb-1.5 border-b border-vx-border font-mono-num">
              <span>Heure</span>
              <span>Côté</span>
              <span class="text-right">Prix</span>
              <span class="text-right">Quantité</span>
            </div>
            <div id="publicTradesList" class="divide-y divide-vx-border/60 text-xs font-mono-num max-h-40 overflow-y-auto"></div>
          </div>
        </details>

        <!-- Pro Module 3: Position Size Calculator (Balance, Risk %, Entry, SL) -->
        <details id="panel-riskcalc" class="hidden group rounded-2xl bg-vx-card border border-vx-border overflow-hidden shadow-lg" open>
          <summary class="flex items-center justify-between px-4 py-3 cursor-pointer select-none bg-[#0b1412] hover:bg-vx-cardHover transition">
            <div class="flex items-center gap-2">
              <span class="text-amber-400 font-extrabold text-xs sm:text-sm">🧮 Calculateur de taille de position (Risk Calculator)</span>
            </div>
            <span class="text-xs text-slate-400 group-open:rotate-180 transition-transform">▾</span>
          </summary>
          <div class="p-3.5 space-y-3 border-t border-vx-border text-xs">
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
              <div>
                <label class="text-slate-400 block mb-1">Capital (USDT)</label>
                <input type="number" id="calcBalanceInput" value="9944.31" step="100" oninput="updateProRiskCalculator()" class="w-full px-3 py-2 rounded-xl bg-[#060c0b] border border-vx-border text-white font-mono-num" />
              </div>
              <div>
                <label class="text-slate-400 block mb-1">Risque (%)</label>
                <input type="number" id="calcRiskPct" value="1.0" step="0.1" oninput="updateProRiskCalculator()" class="w-full px-3 py-2 rounded-xl bg-[#060c0b] border border-vx-border text-white font-mono-num" />
              </div>
              <div>
                <label class="text-slate-400 block mb-1">Prix d'Entrée</label>
                <input type="number" id="calcEntryPrice" value="64266.5" step="any" oninput="updateProRiskCalculator()" class="w-full px-3 py-2 rounded-xl bg-[#060c0b] border border-vx-border text-white font-mono-num" />
              </div>
              <div>
                <label class="text-slate-400 block mb-1">Prix Stop-Loss</label>
                <input type="number" id="calcSlPrice" value="63820.0" step="any" oninput="updateProRiskCalculator()" class="w-full px-3 py-2 rounded-xl bg-[#060c0b] border border-vx-border text-red-400 font-mono-num" />
              </div>
            </div>
            <div class="flex flex-wrap items-center justify-between gap-2 p-3 rounded-xl bg-[#060c0b] border border-vx-border">
              <div class="space-y-0.5">
                <div class="text-slate-400 text-[11px]">Risque monétaire : <span id="calcMaxLossUsd" class="text-red-400 font-mono-num font-bold">99,44 USDT</span></div>
                <div id="calcRecommendedSize" class="text-xs sm:text-sm font-extrabold text-emerald-400 font-mono-num">Position : 14 312,50 USDT • Quantité : 0,2227 unités</div>
              </div>
              <button onclick="applyCalcToOrder()" class="px-3.5 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-black font-extrabold text-xs transition">
                Injecter dans l'ordre
              </button>
            </div>
          </div>
        </details>

        <!-- Pro Module 4: Custom Price Alerts -->
        <details id="panel-alerts" class="hidden group rounded-2xl bg-vx-card border border-vx-border overflow-hidden shadow-lg" open>
          <summary class="flex items-center justify-between px-4 py-3 cursor-pointer select-none bg-[#0b1412] hover:bg-vx-cardHover transition">
            <div class="flex items-center gap-2">
              <span class="text-purple-400 font-extrabold text-xs sm:text-sm">🔔 Alertes de prix personnalisables</span>
            </div>
            <span class="text-xs text-slate-400 group-open:rotate-180 transition-transform">▾</span>
          </summary>
          <div class="p-3.5 space-y-3 border-t border-vx-border text-xs">
            <div class="flex gap-2">
              <input type="number" id="alertTargetPrice" placeholder="Seuil de prix (ex: 65000)" class="flex-1 px-3 py-2 rounded-xl bg-[#060c0b] border border-vx-border text-white font-mono-num" />
              <button onclick="addPriceAlert()" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-black font-extrabold transition">
                + Ajouter Alerte
              </button>
            </div>
            <div id="priceAlertsList" class="space-y-1.5"></div>
          </div>
        </details>

      </div>

      <!-- 2. INTERACTIVE CANDLESTICK CHART CARD (LIGHTWEIGHT CHARTS STYLE + PROJECTION MANUELLE) -->
      <div class="rounded-2xl bg-vx-card border border-vx-border p-3.5 shadow-lg space-y-3">
        <!-- Top Binance-Style View Selector & Live Alert Bar -->
        <div class="flex flex-wrap items-center justify-between gap-2 pb-2 border-b border-vx-border/70 text-[11px]">
          <div class="flex items-center gap-1.5">
            <span class="text-slate-400 font-semibold">Vue :</span>
            <button onclick="setTerminalLayout('standard')" id="layoutBtn-standard" class="px-2 py-0.5 rounded-md bg-emerald-950 text-[#00e676] border border-emerald-500/40 font-bold transition">Standard</button>
            <button onclick="setTerminalLayout('chart')" id="layoutBtn-chart" class="px-2 py-0.5 rounded-md bg-[#060c0b] text-slate-400 border border-vx-border hover:text-white transition">Focus Graph</button>
            <button onclick="openCatalogModal()" class="px-2.5 py-0.5 rounded-md bg-blue-950/70 text-blue-300 border border-blue-500/30 font-bold hover:bg-blue-900 transition">🔍 Sélecteur d'actifs</button>
          </div>
          <div class="flex items-center gap-2 font-mono-num">
            <span class="px-2 py-0.5 rounded-md bg-[#060c0b] border border-vx-border text-amber-300" id="nextCandleTimer">⏱ Bougie : 00:42</span>
            <span class="px-2 py-0.5 rounded-md bg-[#060c0b] border border-vx-border text-emerald-300" id="volatilityGaugeBadge">⚡ Volatilité : 1.42% (Saine)</span>
          </div>
        </div>

        <!-- Asset Header -->
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-2.5">
            <div id="termAssetBadge" class="w-10 h-10 rounded-xl bg-[#0b1412] border border-emerald-500/30 flex items-center justify-center font-extrabold text-sm text-emerald-400 shadow-inner">
              BT
            </div>
            <div>
              <div class="flex items-center gap-1.5">
                <h1 id="termAssetSymbol" class="font-extrabold text-base text-white tracking-tight">BTC-USDT</h1>
                <span id="termAssetCategory" class="px-2 py-0.5 text-[10px] font-bold uppercase rounded-md bg-blue-950/90 text-blue-400 border border-blue-500/30">CRYPTO</span>
                <button onclick="toggleFavoriteCurrent()" id="termFavBtn" class="text-base text-amber-400 hover:scale-110 transition" title="Favori">★</button>
                <button onclick="quickAlertCurrentAsset()" class="px-1.5 py-0.5 rounded-lg bg-purple-950/80 border border-purple-500/30 text-purple-300 text-xs hover:bg-purple-900 transition" title="Alerte rapide sur cet actif">🔔</button>
              </div>
              <p id="termAssetName" class="text-xs text-slate-400">Bitcoin Perpétuel • Hyperliquid</p>
            </div>
          </div>

          <div class="text-right">
            <div id="termAssetPrice" class="font-mono-num font-extrabold text-lg sm:text-xl text-white">64 266,50</div>
            <div id="termAssetChange" class="font-mono-num text-xs font-semibold text-[#00e676]">+1 575,3 • +2.14 % / 24 h</div>
          </div>
        </div>

        <!-- Timeframe & Overlay Controls -->
        <div class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-vx-border">
          <div class="flex items-center gap-1" id="timeframeButtons">
            <button onclick="setTimeframe('1m')" data-tf="1m" class="tf-btn px-2 py-1 rounded-lg text-xs font-semibold text-slate-400 hover:text-white">1m</button>
            <button onclick="setTimeframe('5m')" data-tf="5m" class="tf-btn px-2 py-1 rounded-lg text-xs font-semibold text-slate-400 hover:text-white">5m</button>
            <button onclick="setTimeframe('15m')" data-tf="15m" class="tf-btn px-2.5 py-1 rounded-lg text-xs font-bold bg-blue-950 text-blue-400 border border-blue-500/40">15m</button>
            <button onclick="setTimeframe('1h')" data-tf="1h" class="tf-btn px-2 py-1 rounded-lg text-xs font-semibold text-slate-400 hover:text-white">1h</button>
            <button onclick="setTimeframe('4h')" data-tf="4h" class="tf-btn px-2 py-1 rounded-lg text-xs font-semibold text-slate-400 hover:text-white">4h</button>
            <button onclick="setTimeframe('1D')" data-tf="1D" class="tf-btn px-2 py-1 rounded-lg text-xs font-semibold text-slate-400 hover:text-white">1D</button>
          </div>

          <div class="flex items-center gap-1.5">
            <button onclick="toggleChartTpSl()" id="btnChartTpSl" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-emerald-950/80 text-emerald-300 border border-emerald-500/30 transition">
              TP/SL
            </button>
            <button onclick="toggleChartIndicators()" id="btnChartInd" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-[#0b1412] text-slate-200 border border-vx-border transition">
              Indicateurs <span class="ml-1 px-1.5 py-0.2 rounded-full bg-blue-500/20 text-blue-300 text-[10px]">3</span>
            </button>
          </div>
        </div>

        <!-- MANUAL FUTURE PROJECTION CONTROLLER (STEP-BY-STEP LINEAR REGRESSION) -->
        <div class="flex flex-wrap items-center justify-between gap-2 p-2.5 rounded-xl bg-[#060c0b] border border-emerald-500/30 text-xs">
          <div class="flex items-center gap-2">
            <span class="text-emerald-400 font-extrabold">🔮 Projection Future (Manuel) :</span>
            <span id="projStatusBadge" class="font-mono-num text-[11px] px-2 py-0.5 rounded bg-vx-card text-slate-300 border border-vx-border">0 bougie projetée</span>
          </div>
          <div class="flex flex-wrap items-center gap-1.5">
            <button onclick="stepFutureProjection(1)" class="px-2.5 py-1 rounded-lg bg-emerald-950 hover:bg-emerald-900 border border-emerald-500/40 text-[#00e676] font-extrabold text-[11px] transition active:scale-95">
              +1 Bougie ▸
            </button>
            <button onclick="stepFutureProjection(3)" class="px-2.5 py-1 rounded-lg bg-blue-950 hover:bg-blue-900 border border-blue-500/40 text-blue-300 font-extrabold text-[11px] transition active:scale-95">
              +3 Bougies ▸▸
            </button>
            <button onclick="resetFutureProjection()" class="px-2 py-1 rounded-lg bg-vx-card hover:bg-vx-cardHover border border-vx-border text-slate-300 font-semibold text-[11px] transition">
              ↺ Reset
            </button>
          </div>
        </div>

        <!-- 60FPS Lightweight-Style Canvas with Candlesticks, Subtle Grid, High-Contrast Tags & Future Cone -->
        <div id="chartCanvasWrapper" class="relative w-full h-64 sm:h-72 rounded-xl bg-[#060c0b] border border-vx-border overflow-hidden transition-all">
          <canvas id="tradingCanvas" class="w-full h-full block cursor-crosshair"></canvas>
          <div class="absolute top-2 left-2.5 pointer-events-none flex flex-wrap items-center gap-3 text-[10px] font-mono-num">
            <span class="text-sky-400">● EMA 20</span>
            <span class="text-amber-400">● EMA 50</span>
            <span class="text-purple-400">● VWAP</span>
            <span class="text-emerald-400/80">▮ Volume</span>
            <span id="legendProjection" class="hidden text-emerald-300 font-bold">⇢ Cône Régression IA</span>
          </div>
          <div class="absolute bottom-6 left-3 pointer-events-none flex items-center gap-1.5 opacity-80">
            <span class="px-1.5 py-0.5 rounded bg-[#101d1a] border border-vx-border text-[10px] font-extrabold text-emerald-400">LW • CANVAS PRO</span>
          </div>
        </div>

        <!-- Structured Technical Indicators Sub-Panel (Airy Layout Under Chart) -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-1">
          <div class="p-2.5 rounded-xl bg-[#060c0b] border border-vx-border">
            <div class="text-[10px] text-slate-400 uppercase font-semibold">RSI (14)</div>
            <div id="indRsiVal" class="font-mono-num font-extrabold text-xs text-white mt-0.5">54.4 • Neutre/Haussier</div>
          </div>
          <div class="p-2.5 rounded-xl bg-[#060c0b] border border-vx-border">
            <div class="text-[10px] text-slate-400 uppercase font-semibold">MACD (12,26,9)</div>
            <div id="indMacdVal" class="font-mono-num font-extrabold text-xs text-[#00e676] mt-0.5">+184.09 • Croisement ↗</div>
          </div>
          <div class="p-2.5 rounded-xl bg-[#060c0b] border border-vx-border">
            <div class="text-[10px] text-slate-400 uppercase font-semibold">VWAP Institutionnel</div>
            <div id="indVwapVal" class="font-mono-num font-extrabold text-xs text-purple-300 mt-0.5">Au-dessus (+0.42%)</div>
          </div>
          <div class="p-2.5 rounded-xl bg-[#060c0b] border border-vx-border">
            <div class="text-[10px] text-slate-400 uppercase font-semibold">Backtest Moteur (90j)</div>
            <div id="indBacktestVal" class="font-mono-num font-extrabold text-xs text-amber-300 mt-0.5">68.4% Win • PF 2.14</div>
          </div>
        </div>

        <div class="flex items-center justify-between text-[11px] text-slate-400 pt-0.5">
          <span id="chartFeedStatus">Hyperliquid - cotations et WebSocket en direct</span>
          <span id="chartLastUpdate">Dernière mise à jour : maintenant</span>
        </div>
      </div>

      <!-- 3. ANALYSE QUANTITATIVE (SIGNAL QUANTITATIF & MOTEUR MULTI-PÉRIODES) -->
      <div class="rounded-2xl bg-vx-card border border-vx-border p-4 shadow-lg space-y-4">
        <div class="flex items-start justify-between gap-2">
          <div>
            <div class="text-[11px] font-bold uppercase tracking-widest text-emerald-400">MOTEUR ALGORITHMIQUE • MULTI-PÉRIODES + SENTIMENT</div>
            <h2 class="text-lg font-extrabold text-white">Signal quantitatif</h2>
          </div>
          <div id="quantDirectionBadge" class="px-3 py-1.5 rounded-xl bg-emerald-950/90 border border-emerald-500/40 text-[#00e676] font-extrabold text-xs tracking-wide">
            ↗ ACHAT
          </div>
        </div>

        <!-- Confidence Level Bar -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between text-xs">
            <span class="text-slate-400 font-medium">Niveau de confiance algorithmique</span>
            <span id="quantConfidenceTxt" class="font-mono-num font-extrabold text-white text-sm">74 %</span>
          </div>
          <div class="w-full h-2 rounded-full bg-[#060c0b] overflow-hidden border border-vx-border">
            <div id="quantConfidenceBar" class="h-full bg-[#00e676] rounded-full transition-all duration-500" style="width: 74%"></div>
          </div>
        </div>

        <!-- MTF Dots & News Bias -->
        <div class="flex flex-wrap items-center justify-between gap-2 pt-1 text-xs">
          <div class="flex items-center gap-3">
            <span class="flex items-center gap-1.5"><span id="mtf15m" class="w-2.5 h-2.5 rounded-full bg-[#00e676]"></span> 15m</span>
            <span class="flex items-center gap-1.5"><span id="mtf1h" class="w-2.5 h-2.5 rounded-full bg-[#00e676]"></span> 1h</span>
            <span class="flex items-center gap-1.5"><span id="mtf4h" class="w-2.5 h-2.5 rounded-full bg-[#00e676]"></span> 4h</span>
            <span class="flex items-center gap-1.5"><span id="mtf1d" class="w-2.5 h-2.5 rounded-full bg-[#00e676]"></span> 1D</span>
          </div>
          <span id="quantNewsBias" class="px-2.5 py-0.5 rounded-lg bg-[#060c0b] border border-vx-border text-emerald-300 text-xs font-semibold">Sentiment News : Haussier</span>
        </div>

        <!-- High-Contrast Entry / Stop-Loss / Take-Profit Cards -->
        <div class="grid grid-cols-3 gap-2.5">
          <div class="p-3 rounded-xl bg-[#060c0b] border-2 border-sky-500/40 shadow-inner">
            <div class="text-[11px] text-sky-300 font-bold uppercase mb-1">Entrée</div>
            <div id="quantEntry" class="font-mono-num font-extrabold text-sm sm:text-base text-white">64 266,50</div>
          </div>
          <div class="p-3 rounded-xl bg-red-950/25 border-2 border-red-500/50 shadow-inner">
            <div class="text-[11px] text-red-300 font-bold uppercase mb-1">Stop-loss</div>
            <div id="quantSl" class="font-mono-num font-extrabold text-sm sm:text-base text-red-400">63 820,00</div>
          </div>
          <div class="p-3 rounded-xl bg-emerald-950/25 border-2 border-emerald-500/50 shadow-inner">
            <div class="text-[11px] text-emerald-300 font-bold uppercase mb-1">Take-profit</div>
            <div id="quantTp" class="font-mono-num font-extrabold text-sm sm:text-base text-[#00e676]">65 180,00</div>
          </div>
        </div>

        <!-- 6 Technical Confluence Points -->
        <ul id="quantBullets" class="space-y-2 text-xs text-slate-300 border-t border-vx-border pt-3">
          <li class="flex items-start gap-2"><span class="text-blue-400 mt-0.5">●</span><span>Tendance haussière : le cours évolue au-dessus de l'EMA 20 et du VWAP.</span></li>
          <li class="flex items-start gap-2"><span class="text-blue-400 mt-0.5">●</span><span>Croisement EMA 20 > EMA 50 validé ; histogramme MACD positif (+184.09).</span></li>
          <li class="flex items-start gap-2"><span class="text-blue-400 mt-0.5">●</span><span>RSI (14) à 54.4 : momentum haussier sain sans zone de surachat.</span></li>
          <li class="flex items-start gap-2"><span class="text-blue-400 mt-0.5">●</span><span>Volume supérieur à la moyenne 20 périodes (1.69x) confirmant l'impulsion.</span></li>
          <li class="flex items-start gap-2"><span class="text-blue-400 mt-0.5">●</span><span>Confluence MTF : 15m, 1h, 4h et 1D alignés avec le flux d'actualités macro.</span></li>
          <li class="flex items-start gap-2"><span class="text-blue-400 mt-0.5">●</span><span>Backtesting 90 jours : 68.4% de réussite sur cette configuration technique.</span></li>
        </ul>

        <!-- Score & Action Footer -->
        <div class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-vx-border text-xs">
          <div>
            <span class="text-slate-400">Score Confluence</span>
            <span id="quantScore" class="font-mono-num font-extrabold text-[#00e676] ml-1">+4.2</span>
            <span class="text-slate-400">sur ±5,5</span>
          </div>
          <div class="flex items-center gap-3">
            <button onclick="useQuantSignalInOrder()" class="px-3 py-1.5 rounded-xl bg-emerald-950/90 hover:bg-emerald-900 border border-emerald-500/40 text-emerald-300 font-bold transition">
              Utiliser le signal
            </button>
            <button onclick="openAiPromptModal()" class="text-blue-400 hover:text-blue-300 font-bold flex items-center gap-1">
              <span>Analyse complète</span>
              <span>→</span>
            </button>
          </div>
        </div>
      </div>

      <!-- 4. EXÉCUTION · SIMULATEUR D'ORDRE & PARE-FEU TEMPS RÉEL -->
      <div id="orderSimulatorCard" class="rounded-2xl bg-vx-card border border-vx-border p-4 shadow-lg space-y-4">
        <div class="flex items-center justify-between gap-2">
          <div>
            <div id="execModeSubtitle" class="text-[11px] font-bold uppercase tracking-widest text-slate-400">EXÉCUTION • PAPER TRADING</div>
            <h2 class="text-lg font-extrabold text-white">Simulateur d'ordre</h2>
          </div>
          <button onclick="useQuantSignalInOrder()" class="px-3 py-1.5 rounded-xl bg-[#0b1412] hover:bg-vx-cardHover border border-vx-border text-blue-400 text-xs font-bold transition active:scale-95">
            Utiliser le signal
          </button>
        </div>

        <!-- Direction Toggle: Acheter Long / Vendre Short -->
        <div class="grid grid-cols-2 gap-2.5">
          <button onclick="setOrderSide('LONG')" id="btnSideLong" class="py-3 rounded-xl font-extrabold text-sm border transition bg-emerald-950/90 border-emerald-500 text-[#00e676] shadow-inner">
            Acheter <span class="font-normal opacity-90">Long</span>
          </button>
          <button onclick="setOrderSide('SHORT')" id="btnSideShort" class="py-3 rounded-xl font-extrabold text-sm border transition bg-[#060c0b] border-vx-border text-slate-400 hover:text-white">
            Vendre <span class="font-normal opacity-90">Short</span>
          </button>
        </div>

        <!-- Margin Input + 25% / 50% / 75% / MAX -->
        <div class="space-y-2">
          <div class="flex justify-between text-xs">
            <span class="text-slate-400 font-medium">Marge engagée</span>
            <span id="dynamicUnitsPreview" class="text-emerald-400 font-mono-num font-bold">Qté dyn. : 0.0117 u.</span>
          </div>
          <input type="number" id="orderMarginInput" value="250" min="10" step="10" oninput="validateAndCalculateOrder()" class="w-full px-3.5 py-2.5 rounded-xl bg-[#060c0b] border border-vx-border text-white font-mono-num font-bold text-base focus:outline-none focus:border-emerald-500" />
          <div class="grid grid-cols-4 gap-2 pt-0.5">
            <button onclick="setMarginPercent(0.25)" class="py-1.5 rounded-xl bg-[#060c0b] hover:bg-[#0b1412] border border-vx-border text-xs font-semibold text-slate-300 transition">25 %</button>
            <button onclick="setMarginPercent(0.50)" class="py-1.5 rounded-xl bg-[#060c0b] hover:bg-[#0b1412] border border-vx-border text-xs font-semibold text-slate-300 transition">50 %</button>
            <button onclick="setMarginPercent(0.75)" class="py-1.5 rounded-xl bg-[#060c0b] hover:bg-[#0b1412] border border-vx-border text-xs font-semibold text-slate-300 transition">75 %</button>
            <button onclick="setMarginPercent(1.00)" class="py-1.5 rounded-xl bg-[#060c0b] hover:bg-[#0b1412] border border-vx-border text-xs font-semibold text-emerald-400 transition">MAX</button>
          </div>
        </div>

        <!-- Leverage Slider + Direct Numeric Input -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between text-xs">
            <span class="text-slate-400 font-medium">Levier (Curseur ou Saisie directe)</span>
            <div class="flex items-center gap-1.5">
              <span class="text-slate-400 font-mono-num">x</span>
              <input type="number" id="orderLeverageNumber" min="1" max="100" value="3" oninput="syncLeverageFromNumber(this.value)" class="w-16 px-2 py-1 rounded-lg bg-[#060c0b] border border-emerald-500/40 text-right font-mono-num font-extrabold text-white text-xs focus:outline-none" />
              <span id="orderLeverageLabel" class="hidden">x3</span>
            </div>
          </div>
          <input type="range" id="orderLeverageSlider" min="1" max="100" value="3" oninput="syncLeverageFromSlider(this.value)" class="w-full" />
          <div class="flex justify-between text-[11px] text-slate-400 font-mono-num">
            <span>x1</span>
            <span>x25</span>
            <span>x50</span>
            <span>x100 • garde-fou x100</span>
          </div>
        </div>

        <!-- Editable Entry / SL / TP Inputs -->
        <div class="space-y-2.5">
          <div>
            <label class="text-xs text-slate-400 block mb-1">Entrée</label>
            <input type="number" id="orderEntryInput" step="any" oninput="validateAndCalculateOrder()" class="w-full px-3.5 py-2.5 rounded-xl bg-[#060c0b] border border-vx-border text-white font-mono-num font-bold text-sm focus:outline-none focus:border-emerald-500" />
          </div>
          <div class="grid grid-cols-2 gap-2.5">
            <div>
              <label class="text-xs text-slate-400 block mb-1">Stop-loss</label>
              <input type="number" id="orderSlInput" step="any" oninput="validateAndCalculateOrder()" class="w-full px-3.5 py-2.5 rounded-xl bg-[#060c0b] border border-vx-border text-red-400 font-mono-num font-bold text-sm focus:outline-none focus:border-red-500" />
            </div>
            <div>
              <label class="text-xs text-slate-400 block mb-1">Take-profit</label>
              <input type="number" id="orderTpInput" step="any" oninput="validateAndCalculateOrder()" class="w-full px-3.5 py-2.5 rounded-xl bg-[#060c0b] border border-vx-border text-[#00e676] font-mono-num font-bold text-sm focus:outline-none focus:border-emerald-500" />
            </div>
          </div>
        </div>

        <!-- Visual Global Risk Level Indicator -->
        <div class="p-3 rounded-xl bg-[#060c0b] border border-vx-border space-y-1.5">
          <div class="flex items-center justify-between text-xs">
            <span class="text-slate-400 font-semibold">Jauge de Risque Global du Trade</span>
            <span id="globalRiskBadge" class="font-mono-num font-extrabold text-[#00e676]">Faible • 0.53% du capital</span>
          </div>
          <div class="w-full h-2 rounded-full bg-[#101d1a] overflow-hidden border border-vx-border">
            <div id="globalRiskBar" class="h-full bg-[#00e676] transition-all duration-300" style="width: 26%"></div>
          </div>
        </div>

        <!-- 4 Real-Time Metric Boxes -->
        <div class="grid grid-cols-2 gap-2.5">
          <div class="p-3 rounded-xl bg-[#060c0b] border border-vx-border">
            <div class="text-[11px] text-slate-400">Position (Taille dyn.)</div>
            <div id="simPositionSize" class="font-mono-num font-extrabold text-sm text-white mt-0.5">750 USDT</div>
          </div>
          <div class="p-3 rounded-xl bg-[#060c0b] border border-vx-border">
            <div class="text-[11px] text-slate-400">Risque max.</div>
            <div id="simMaxRisk" class="font-mono-num font-extrabold text-sm text-red-400 mt-0.5">-26,7 USDT</div>
          </div>
          <div class="p-3 rounded-xl bg-[#060c0b] border border-vx-border">
            <div class="text-[11px] text-slate-400">Gain visé</div>
            <div id="simTargetGain" class="font-mono-num font-extrabold text-sm text-[#00e676] mt-0.5">+55,0 USDT</div>
          </div>
          <div class="p-3 rounded-xl bg-[#060c0b] border border-vx-border">
            <div class="text-[11px] text-slate-400">Liquidation est.</div>
            <div id="simLiqPrice" class="font-mono-num font-extrabold text-sm text-white mt-0.5">43 202,61</div>
          </div>
        </div>

        <!-- VALIDATION DES RISQUES (PARE-FEU TEMPS RÉEL - 8 RÈGLES) -->
        <div class="rounded-xl bg-[#060c0b] border border-vx-border p-3.5 space-y-2.5">
          <div class="flex items-center justify-between text-xs font-bold text-slate-200">
            <div class="flex items-center gap-2">
              <span class="text-blue-400">✓</span>
              <span>Validation des risques (Pare-feu temps réel)</span>
            </div>
            <label class="flex items-center gap-1.5 text-[11px] text-slate-400 font-normal cursor-pointer">
              <input type="checkbox" id="chkConfirmBeforeExec" checked class="accent-emerald-500 rounded" />
              <span>Confirmation visuelle</span>
            </label>
          </div>
          <ul id="riskChecklist" class="space-y-1.5 text-xs font-mono-num"></ul>
        </div>

        <!-- Firewall Blocked Warning Banner -->
        <div id="firewallBanner" class="hidden p-3 rounded-xl bg-red-950/60 border border-red-500/40 text-red-300 text-xs font-semibold">
          Ordre bloqué par le pare-feu : Placés du bon côté du prix d'entrée.
        </div>

        <!-- Visual Confirmation Step Box (Appears before final execution when enabled) -->
        <div id="orderConfirmBox" class="hidden p-3.5 rounded-xl bg-emerald-950/60 border-2 border-[#00e676] space-y-2.5 text-xs">
          <div class="font-extrabold text-white flex items-center justify-between">
            <span>🛡️ Confirmation finale de l'ordre</span>
            <span id="confirmBoxSummary" class="font-mono-num text-[#00e676]">LONG BTC-USDT</span>
          </div>
          <p id="confirmBoxDetails" class="text-slate-300 font-mono-num text-[11px]"></p>
          <div class="grid grid-cols-2 gap-2 pt-1">
            <button onclick="cancelOrderConfirmation()" class="py-2 rounded-xl bg-[#060c0b] border border-vx-border text-slate-300 font-bold">Annuler</button>
            <button onclick="finalizeOrderExecution()" class="py-2 rounded-xl bg-[#00e676] text-black font-extrabold shadow-lg">✓ Confirmer & Envoyer</button>
          </div>
        </div>

        <!-- Submit Execution Button (Distinctive Institutional Gradient & Glow) -->
        <button onclick="executeSimulatedOrLiveOrder()" id="btnSubmitOrder" class="w-full py-4 rounded-xl bg-gradient-to-r from-emerald-500 via-[#00e676] to-teal-400 hover:brightness-110 disabled:opacity-40 disabled:cursor-not-allowed text-black font-extrabold text-sm tracking-wider uppercase transition shadow-[0_0_20px_rgba(0,230,118,0.35)] border border-emerald-300/50">
          ⚡ Ouvrir Long • Paper
        </button>
        <p id="orderSimFootnote" class="text-center text-[11px] text-slate-400">
          Simulation uniquement • Aucun ordre n'est envoyé à un courtier.
        </p>
      </div>

      <!-- 5. LISTE DE SUIVI (MARCHÉS) -->
      <div id="watchlistSection" class="rounded-2xl bg-vx-card border border-vx-border p-4 shadow-lg space-y-3">
        <div class="flex items-center justify-between">
          <div>
            <div class="text-[11px] font-bold uppercase tracking-widest text-slate-400">LISTE DE SUIVI</div>
            <h2 class="text-lg font-extrabold text-white">Marchés</h2>
          </div>
          <button onclick="openCatalogModal()" class="px-3 py-1.5 rounded-xl bg-[#0b1412] hover:bg-vx-cardHover border border-vx-border text-xs font-bold text-slate-200 transition">
            🔍 Sélecteur (32 actifs)
          </button>
