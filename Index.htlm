      const filtered = ASSETS.filter(a => state.signalsFilter === 'Tous' || a.category === state.signalsFilter);

      container.innerHTML = filtered.map(a => {
        const isBuy = a.signal === 'ACHAT';
        return `
          <div class="rounded-2xl bg-[#060c0b] border border-vx-border p-4 space-y-3.5 shadow-md">
            <div class="flex items-center justify-between gap-2">
              <div class="flex items-baseline gap-2">
                <h3 class="text-base font-extrabold text-white">${a.symbol}</h3>
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">${a.category}</span>
              </div>
              <span class="px-2.5 py-1 rounded-lg text-xs font-extrabold ${isBuy ? 'bg-emerald-950/90 text-[#00e676] border border-emerald-500/30' : 'bg-red-950/90 text-red-400 border border-red-500/30'}">
                ${isBuy ? '↗ ACHAT' : '↘ VENTE'} (${a.conf}%)
              </span>
            </div>

            <div class="grid grid-cols-3 gap-2 pt-1">
              <div class="p-2.5 rounded-xl bg-vx-card border border-sky-500/30">
                <div class="text-[10px] text-sky-300 font-bold uppercase">Entrée</div>
                <div class="font-mono-num font-extrabold text-sm text-white mt-0.5">${formatNum(a.entry, a.decimals)}</div>
              </div>
              <div class="p-2.5 rounded-xl bg-red-950/20 border border-red-500/40">
                <div class="text-[10px] text-red-300 font-bold uppercase">Stop-Loss</div>
                <div class="font-mono-num font-extrabold text-sm text-red-400 mt-0.5">${formatNum(a.sl, a.decimals)}</div>
              </div>
              <div class="p-2.5 rounded-xl bg-emerald-950/20 border border-emerald-500/40">
                <div class="text-[10px] text-emerald-300 font-bold uppercase">Take-Profit</div>
                <div class="font-mono-num font-extrabold text-sm text-[#00e676] mt-0.5">${formatNum(a.tp, a.decimals)}</div>
              </div>
            </div>

            <button onclick="loadSignalOntoTerminal('${a.symbol}')" class="w-full py-2.5 rounded-xl bg-emerald-950/80 hover:bg-emerald-900 border border-emerald-500/40 text-[#00e676] font-extrabold text-xs tracking-wide transition flex items-center justify-center gap-1.5 active:scale-98">
              <span>⚡ Charger sur le Terminal ▸</span>
            </button>
          </div>
        `;
      }).join('');
    }

    function loadSignalOntoTerminal(symbol) {
      selectAsset(symbol, true);
      switchTab('terminal');
      showToast(`Signal ${symbol} chargé sur le Terminal`, '⚡');
    }

    // =========================================================================
    // 12. TAB 3: PORTEFEUILLE, COURBE D'ÉQUITÉ, MULTI-WALLETS & HYPERLIQUID
    // =========================================================================
    function setExecutionMode(mode) {
      state.executionMode = mode;
      const btnPaper = document.getElementById('btnModePaper');
      const btnLive = document.getElementById('btnModeLive');
      const headerText = document.getElementById('headerModeText');
      const subtitle = document.getElementById('execModeSubtitle');
      const footnote = document.getElementById('orderSimFootnote');
      const execDesc = document.getElementById('execModeDesc');

      if (mode === 'PAPER') {
        btnPaper.className = 'py-2.5 rounded-xl font-extrabold text-xs border transition bg-blue-950/90 border-blue-500 text-blue-300';
        btnLive.className = 'py-2.5 rounded-xl font-extrabold text-xs border transition bg-[#060c0b] border-vx-border text-slate-400 hover:text-white';
        headerText.textContent = 'Hyperliquid • WebSocket';
        subtitle.textContent = 'EXÉCUTION • PAPER TRADING';
        execDesc.textContent = "Simulation locale : aucun ordre n'est envoyé.";
        footnote.textContent = "Simulation uniquement • Aucun ordre n'est envoyé à un courtier.";
      } else {
        btnLive.className = 'py-2.5 rounded-xl font-extrabold text-xs border transition bg-emerald-950/90 border-emerald-500 text-[#00e676]';
        btnPaper.className = 'py-2.5 rounded-xl font-extrabold text-xs border transition bg-[#060c0b] border-vx-border text-slate-400 hover:text-white';
        headerText.textContent = 'Hyperliquid • Live Mainnet';
        subtitle.textContent = 'EXÉCUTION • HYPERLIQUID LIVE';
        execDesc.textContent = 'Mode Hyperliquid Mainnet actif : ordres signés via API Agent à frais réduits.';
        footnote.textContent = 'Mode Hyperliquid Live actif • Exécution directe via Agent API.';
      }
      validateAndCalculateOrder();
      showToast(`Mode d'exécution : ${mode === 'PAPER' ? 'Paper Trading' : 'Hyperliquid Live'}`, '💳');
    }

    function saveHyperliquidKeys() {
      const wallet = document.getElementById('hlWalletInput').value.trim();
      const key = document.getElementById('hlAgentKeyInput').value.trim();
      if (!wallet.startsWith('0x') || wallet.length < 10) {
        showToast('Veuillez saisir une adresse Wallet 0x... valide', '⚠️');
        return;
      }
      state.hlWallet = wallet;
      state.hlAgentConnected = Boolean(key);
      const badge = document.getElementById('hlConnectionBadge');
      badge.textContent = 'Connecté • Frais Réduits';
      badge.className = 'px-2.5 py-1 rounded-lg text-xs font-bold bg-emerald-950/90 text-[#00e676] border border-emerald-500/40';
      setExecutionMode('LIVE');
      showToast('Compte Hyperliquid connecté en mémoire sécurisée', '🔑');
    }

    function addSecondaryWallet() {
      const addrInput = document.getElementById('hlWalletInput').value.trim() || ('0x' + Math.random().toString(16).slice(2, 6).toUpperCase() + '...' + Math.random().toString(16).slice(2, 6).toUpperCase());
      state.externalWallets.push({
        name: `Portefeuille Crypto #${state.externalWallets.length + 1} (DEX / Hyperliquid)`,
        addr: addrInput,
        balanceUsd: Math.round(1200 + Math.random() * 3500)
      });
      saveState();
      renderConnectedWallets();
      showToast('Portefeuille crypto externe relié au suivi', '🔗');
    }

    function renderConnectedWallets() {
      const container = document.getElementById('connectedWalletsList');
      if (!container) return;
      container.innerHTML = state.externalWallets.map((w, idx) => `
        <div class="flex items-center justify-between px-3 py-2 rounded-xl bg-[#060c0b] border border-vx-border text-xs">
          <div>
            <span class="font-bold text-white">${w.name}</span>
            <span class="text-slate-400 font-mono-num ml-2">${w.addr}</span>
          </div>
          <span class="font-mono-num font-bold text-[#00e676]">${formatNum(w.balanceUsd, 2)} USDT</span>
        </div>
      `).join('');
    }

    function setHistoryFilter(filt) {
      state.historyFilter = filt;
      document.querySelectorAll('.hfilt-btn').forEach(btn => {
        if (btn.dataset.hfilt === filt) {
          btn.className = 'hfilt-btn px-3 py-1 rounded-xl text-xs font-extrabold bg-emerald-950 text-[#00e676] border border-emerald-500/40';
        } else {
          btn.className = 'hfilt-btn px-3 py-1 rounded-xl text-xs font-semibold bg-[#060c0b] text-slate-300 border border-vx-border';
        }
      });
      renderPortfolioTab();
    }

    function drawEquityCurve(currentEquity) {
      const canvas = document.getElementById('equityCurveCanvas');
      if (!canvas) return;
      const rect = canvas.parentElement.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) return;

      const dpr = window.devicePixelRatio || 1;
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      const ctx = canvas.getContext('2d');
      ctx.scale(dpr, dpr);

      const W = rect.width;
      const H = rect.height;
      ctx.clearRect(0, 0, W, H);

      // Build historical equity points from tradeHistory
      const points = [9706.10];
      const reversedHist = [...state.tradeHistory].reverse();
      reversedHist.forEach(h => {
        points.push(points[points.length - 1] + h.pnl);
      });
      points.push(currentEquity);

      const minV = Math.min(...points) * 0.998;
      const maxV = Math.max(...points) * 1.002;
      const range = (maxV - minV) || 1;

      const grad = ctx.createLinearGradient(0, 0, 0, H);
      grad.addColorStop(0, 'rgba(0, 230, 118, 0.28)');
      grad.addColorStop(1, 'rgba(0, 230, 118, 0.0)');

      ctx.beginPath();
      points.forEach((val, idx) => {
        const x = (idx / Math.max(1, points.length - 1)) * (W - 20) + 10;
        const y = H - 14 - ((val - minV) / range) * (H - 28);
        if (idx === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      });
      ctx.strokeStyle = '#00e676';
      ctx.lineWidth = 2;
      ctx.stroke();

      ctx.lineTo(W - 10, H);
      ctx.lineTo(10, H);
      ctx.closePath();
      ctx.fillStyle = grad;
      ctx.fill();
    }

    function renderPortfolioTab() {
      let totalMargin = 0;
      let totalUnrealizedPnl = 0;

      const openHtml = state.openPositions.map(pos => {
        const asset = ASSETS.find(a => a.symbol === pos.symbol) || ASSETS[0];
        const curPrice = asset.price;
        const diffRatio = pos.side === 'LONG'
          ? (curPrice - pos.entry) / pos.entry
          : (pos.entry - curPrice) / pos.entry;
        const pnl = pos.notional * diffRatio;
        const roePct = pos.margin > 0 ? (pnl / pos.margin) * 100 : 0;

        totalMargin += pos.margin;
        totalUnrealizedPnl += pnl;

        const isProfit = pnl >= 0;
        return `
          <div class="p-3.5 rounded-xl bg-[#060c0b] border border-vx-border space-y-2">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="font-extrabold text-sm text-white">${pos.symbol}</span>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold ${pos.side === 'LONG' ? 'bg-emerald-950 text-[#00e676]' : 'bg-red-950 text-red-400'}">${pos.side} x${pos.lev}</span>
              </div>
              <div class="font-mono-num font-extrabold text-sm ${isProfit ? 'text-[#00e676]' : 'text-red-400'}">
                ${isProfit ? '+' : ''}${formatNum(pnl, 2)} USDT (${isProfit ? '+' : ''}${roePct.toFixed(1)}%)
              </div>
            </div>
            <div class="grid grid-cols-3 text-[11px] text-slate-400 font-mono-num">
              <span>Entrée : ${formatNum(pos.entry, pos.decimals)}</span>
              <span>SL : ${formatNum(pos.sl, pos.decimals)}</span>
              <span>TP : ${formatNum(pos.tp, pos.decimals)}</span>
            </div>
            <div class="flex justify-end pt-1">
              <button onclick="closeOpenPosition(${pos.id})" class="px-3 py-1 rounded-lg bg-vx-card hover:bg-red-950 hover:text-red-300 border border-vx-border text-xs font-bold text-slate-200 transition">
                Clôturer
              </button>
            </div>
          </div>
        `;
      }).join('');

      const openContainer = document.getElementById('openPositionsContainer');
      if (state.openPositions.length === 0) {
        openContainer.innerHTML = `
          <div class="p-6 rounded-xl bg-[#060c0b] border border-vx-border text-center text-xs text-slate-400">
            Aucune position ouverte actuellement.
          </div>
        `;
      } else {
        openContainer.innerHTML = openHtml;
      }

      const equity = state.balance + totalMargin + totalUnrealizedPnl;
      const unrealizedPct = totalMargin > 0 ? (totalUnrealizedPnl / totalMargin) * 100 : 0;

      document.getElementById('pfEquity').textContent = `${formatNum(equity, 2)} USDT`;
      document.getElementById('pfAvailable').textContent = `${formatNum(state.balance, 2)} USDT`;
      document.getElementById('pfMarginUsed').textContent = `Marge engagée : ${formatNum(totalMargin, 2)} USDT`;

      const pnlEl = document.getElementById('pfUnrealizedPnl');
      const isUp = totalUnrealizedPnl >= 0;
      pnlEl.textContent = `${isUp ? '+' : ''}${formatNum(totalUnrealizedPnl, 2)} USDT`;
      pnlEl.className = `font-mono-num font-extrabold text-lg sm:text-xl mt-1 ${isUp ? 'text-[#00e676]' : 'text-red-400'}`;
      document.getElementById('pfUnrealizedPct').textContent = `${isUp ? '+' : ''}${formatNum(unrealizedPct, 2)} % sur marge`;

      const totalClosed = state.tradeHistory.length;
      const winners = state.tradeHistory.filter(t => t.pnl > 0).length;
      const winRate = totalClosed > 0 ? (winners / totalClosed) * 100 : 0;
      document.getElementById('pfWinRate').textContent = `${formatNum(winRate, 1)} %`;
      document.getElementById('pfWinRatioTxt').textContent = `${winners} gagnants / ${totalClosed} clôturés`;

      const assetQuery = (document.getElementById('historyAssetSearch')?.value || '').toLowerCase();
      const filteredHistory = state.tradeHistory.filter(h => {
        if (state.historyFilter === 'WIN' && h.pnl < 0) return false;
        if (state.historyFilter === 'LOSS' && h.pnl >= 0) return false;
        if (assetQuery && !h.symbol.toLowerCase().includes(assetQuery)) return false;
        return true;
      });

      const histContainer = document.getElementById('tradeHistoryContainer');
      if (filteredHistory.length === 0) {
        histContainer.innerHTML = `<div class="text-xs text-slate-400 py-3 text-center">Aucune transaction pour ce filtre.</div>`;
      } else {
        histContainer.innerHTML = filteredHistory.map(h => {
          const win = h.pnl >= 0;
          return `
            <div class="p-3.5 rounded-xl bg-[#060c0b] border border-vx-border flex items-center justify-between gap-2">
              <div class="space-y-0.5">
                <div class="flex items-center gap-2 text-xs">
                  <span class="font-extrabold text-white">${h.symbol}</span>
                  <span class="text-slate-400 font-mono-num">(${h.side} x${h.lev})</span>
                  <span class="text-slate-300">${h.reason}</span>
                </div>
                <div class="text-[11px] text-slate-400 font-mono-num">• ${h.time}</div>
              </div>
              <div class="text-right font-mono-num font-extrabold text-xs sm:text-sm ${win ? 'text-[#00e676]' : 'text-red-400'}">
                <div>${win ? '+' : ''}${formatNum(h.pnl, 2)}</div>
                <div>USDT</div>
              </div>
            </div>
          `;
        }).join('');
      }

      renderConnectedWallets();
      requestAnimationFrame(() => drawEquityCurve(equity));
    }

    function closeOpenPosition(posId) {
      const idx = state.openPositions.findIndex(p => p.id === posId);
      if (idx === -1) return;
      const pos = state.openPositions[idx];
      const asset = ASSETS.find(a => a.symbol === pos.symbol) || ASSETS[0];
      const diffRatio = pos.side === 'LONG'
        ? (asset.price - pos.entry) / pos.entry
        : (pos.entry - asset.price) / pos.entry;
      const pnl = pos.notional * diffRatio;

      state.balance += pos.margin + pnl;
      state.openPositions.splice(idx, 1);

      state.tradeHistory.unshift({
        symbol: pos.symbol,
        side: pos.side,
        lev: pos.lev,
        reason: 'Clôture manuelle',
        time: new Date().toTimeString().slice(0, 5),
        pnl
      });

      saveState();
      renderPortfolioTab();
      validateAndCalculateOrder();
      showToast(`Position ${pos.symbol} clôturée (${pnl >= 0 ? '+' : ''}${formatNum(pnl, 2)} USDT)`, '✅');
    }

    function creditDemoBalance(amount) {
      state.balance += amount;
      saveState();
      renderPortfolioTab();
      validateAndCalculateOrder();
      showToast(`+${formatNum(amount, 0)} USDT crédités`, '💰');
    }

    function resetDemoPortfolio() {
      state.balance = 9944.31;
      state.openPositions = [];
      state.tradeHistory = [...DEFAULT_HISTORY];
      saveState();
      renderPortfolioTab();
      validateAndCalculateOrder();
      showToast('Portefeuille réinitialisé (10k)', '↺');
    }

    function clearTradeHistory() {
      state.tradeHistory = [];
      saveState();
      renderPortfolioTab();
      showToast('Historique vidé', '🗑️');
    }

    // =========================================================================
    // 13. TAB 4: ACTUALITÉS & CALENDRIER ÉCONOMIQUE
    // =========================================================================
    function switchNewsSubtab(sub) {
      const feedPanel = document.getElementById('newsFeedPanel');
      const calPanel = document.getElementById('econCalendarPanel');
      const btnFeed = document.getElementById('btnSubtabFeed');
      const btnCal = document.getElementById('btnSubtabCalendar');

      if (sub === 'feed') {
        feedPanel.classList.remove('hidden');
        calPanel.classList.add('hidden');
        btnFeed.className = 'py-2.5 rounded-xl font-extrabold text-xs transition bg-emerald-950 text-[#00e676] border border-emerald-500/40';
        btnCal.className = 'py-2.5 rounded-xl font-extrabold text-xs transition text-slate-400 hover:text-white';
      } else {
        calPanel.classList.remove('hidden');
        feedPanel.classList.add('hidden');
        btnCal.className = 'py-2.5 rounded-xl font-extrabold text-xs transition bg-amber-950 text-amber-300 border border-amber-500/40';
        btnFeed.className = 'py-2.5 rounded-xl font-extrabold text-xs transition text-slate-400 hover:text-white';
      }
    }

    function filterNews(cat) {
      state.newsFilter = cat;
      document.querySelectorAll('.ncat-btn').forEach(btn => {
        if (btn.dataset.ncat === cat) {
          btn.className = 'ncat-btn px-3.5 py-1.5 rounded-xl text-xs font-extrabold bg-emerald-950 text-[#00e676] border border-emerald-500/40';
        } else {
          btn.className = 'ncat-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-[#060c0b] text-slate-300 border border-vx-border';
        }
      });
      renderNewsTab();
    }

    function renderNewsTab() {
      const container = document.getElementById('newsCardsContainer');
      if (!container) return;

      const filtered = NEWS_ITEMS.filter(item => {
        if (state.newsFilter === 'Toutes') return true;
        if (state.newsFilter === 'Favoris') {
          const asset = ASSETS.find(a => a.symbol === item.symbol);
          return asset && asset.fav;
        }
        return item.bias === state.newsFilter;
      });

      container.innerHTML = filtered.map(item => {
        const isBull = item.bias === 'Haussier';
        return `
          <article class="rounded-2xl bg-[#060c0b] border border-vx-border p-4 space-y-3 shadow-md">
            <div class="flex items-center justify-between gap-2">
              <span class="px-3 py-1 rounded-xl text-xs font-extrabold ${isBull ? 'bg-emerald-950/90 text-[#00e676] border border-emerald-500/30' : 'bg-red-950/90 text-red-400 border border-red-500/30'}">
                ${isBull ? '↗ Haussier' : '↘ Baissier'}
              </span>
              <span class="text-xs text-slate-400 font-mono-num text-right">${item.source} • ${item.time}</span>
            </div>

            <h3 class="text-base font-extrabold text-white leading-snug">${item.title}</h3>
            <p class="text-xs text-slate-300 leading-relaxed">${item.summary}</p>

            <div class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-vx-border">
              <button onclick="loadSignalOntoTerminal('${item.symbol}')" class="px-3 py-1.5 rounded-xl bg-blue-950/70 hover:bg-blue-900 border border-blue-500/30 text-blue-400 text-xs font-extrabold transition">
                Actif : ${item.symbol}
              </button>

              <div class="flex items-center gap-2">
                <button onclick="openArticleModal('${item.id}')" class="px-2.5 py-1.5 rounded-xl bg-vx-card hover:bg-vx-cardHover border border-vx-border text-slate-300 text-xs font-semibold transition">
                  Dépêche
                </button>
                <a href="${item.url}" target="_blank" rel="noopener noreferrer" class="px-3.5 py-1.5 rounded-xl bg-[#101d1a] hover:bg-emerald-950 border border-vx-border hover:border-emerald-500/40 text-white hover:text-[#00e676] text-xs font-extrabold transition flex items-center gap-1">
                  <span>Lire l'article complet ▸</span>
                </a>
              </div>
            </div>
          </article>
        `;
      }).join('');
    }

    function openArticleModal(id) {
      const item = NEWS_ITEMS.find(n => n.id === id);
      if (!item) return;
      document.getElementById('artModalSource').textContent = `${item.source} • ${item.time}`;
      document.getElementById('artModalTitle').textContent = item.title;
      document.getElementById('artModalBody').textContent = item.fullText;
      document.getElementById('artModalImpact').textContent = item.impactNote;
      document.getElementById('artModalExternalLink').href = item.url;
      document.getElementById('artModalLoadAssetBtn').onclick = () => {
        closeArticleModal();
        loadSignalOntoTerminal(item.symbol);
      };
      document.getElementById('articleModal').classList.remove('hidden');
    }

    function closeArticleModal() {
      document.getElementById('articleModal').classList.add('hidden');
    }

    function filterCalendar(level) {
      state.calendarFilter = level;
      document.querySelectorAll('.ccat-btn').forEach(btn => {
        if (btn.dataset.ccat === level) {
          btn.className = 'ccat-btn px-3 py-1.5 rounded-xl text-xs font-extrabold bg-emerald-950 text-[#00e676] border border-emerald-500/40';
        } else {
          btn.className = 'ccat-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-[#060c0b] text-slate-300 border border-vx-border';
        }
      });
      renderCalendarTab();
    }

    function renderCalendarTab() {
      const container = document.getElementById('calendarEventsContainer');
      if (!container) return;

      const filtered = CALENDAR_EVENTS.filter(ev => state.calendarFilter === 'Tous' || ev.impact === state.calendarFilter);

      container.innerHTML = filtered.map(ev => {
        let badgeStyle = 'bg-slate-800/90 text-slate-300 border-slate-700';
        if (ev.impact === 'Fort') {
          badgeStyle = 'bg-red-950/90 text-red-300 border-red-500/40';
        } else if (ev.impact === 'Moyen') {
          badgeStyle = 'bg-amber-950/90 text-amber-300 border-amber-500/40';
        }

        return `
          <div class="rounded-2xl bg-[#060c0b] border border-vx-border p-3.5 space-y-2.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded-lg bg-vx-card border border-vx-border font-mono-num font-bold text-xs text-white">${ev.time}</span>
                <span class="font-bold text-xs text-slate-200">${ev.currency}</span>
              </div>
              <span class="px-2.5 py-1 rounded-lg text-[10px] font-extrabold border ${badgeStyle}">
                ${ev.impactBadge}
              </span>
            </div>

            <h3 class="text-sm font-extrabold text-white">${ev.title}</h3>
            <p class="text-[11px] text-slate-400">${ev.note}</p>

            <div class="grid grid-cols-3 gap-2 p-2.5 rounded-xl bg-vx-card border border-vx-border text-xs font-mono-num">
              <div>
                <div class="text-[10px] text-slate-400">Précédent</div>
                <div class="font-bold text-slate-200">${ev.prev}</div>
              </div>
              <div>
                <div class="text-[10px] text-slate-400">Consensus</div>
                <div class="font-bold text-amber-300">${ev.consensus}</div>
              </div>
              <div>
                <div class="text-[10px] text-slate-400">Actuel</div>
                <div class="font-extrabold ${ev.deltaGood ? 'text-[#00e676]' : 'text-red-400'}">${ev.actual}</div>
              </div>
            </div>

            <div class="flex justify-end">
              <button onclick="loadSignalOntoTerminal('${ev.asset}')" class="text-xs font-bold text-blue-400 hover:text-blue-300">
                Charger ${ev.asset} sur le Terminal ▸
              </button>
            </div>
          </div>
        `;
      }).join('');
    }

    // =========================================================================
    // 14. TAB 5: GARDE-FOUS, PROMPT MAÎTRE V2 & JSON IMPORT/EXPORT
    // =========================================================================
    function copyMasterSpecPrompt() {
      const box = document.getElementById('masterSpecPromptBox');
      const ta = document.createElement('textarea');
      ta.value = box.value;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      ta.remove();
      showToast('Prompt Maître V2 complet copié dans le presse-papiers !', '🚀');
    }

    function saveRiskGuardrails() {
      state.guardrails.maxPositions = parseInt(document.getElementById('guardMaxPositions').value) || 50;
      state.guardrails.maxRiskPct = parseFloat(document.getElementById('guardMaxRiskPct').value) || 2.0;
      state.guardrails.maxDrawdownPct = parseFloat(document.getElementById('guardMaxDrawdownPct').value) || 5.0;
      state.guardrails.minRR = parseFloat(document.getElementById('guardMinRR').value) || 1.5;
      saveState();
      validateAndCalculateOrder();
      showToast('Garde-fous enregistrés et liés au pare-feu', '🛡️');
    }

    function resetRiskGuardrails() {
      state.guardrails = { maxPositions: 50, maxRiskPct: 2.0, maxDrawdownPct: 5.0, minRR: 1.5 };
      document.getElementById('guardMaxPositions').value = 50;
      document.getElementById('guardMaxRiskPct').value = 2;
      document.getElementById('guardMaxDrawdownPct').value = 5;
      document.getElementById('guardMinRR').value = 1.5;
      saveState();
      validateAndCalculateOrder();
      showToast('Garde-fous réinitialisés', '↺');
    }

    function openAiPromptModal() {
      const asset = getCurrentAsset();
      const content = document.getElementById('aiModalContent');
      const rr = ((Math.abs(asset.tp - asset.entry)) / (Math.abs(asset.entry - asset.sl) || 1)).toFixed(2);
      content.innerHTML = `
        <div class="text-[#00e676] font-bold mb-1">⚡ BRIEFING QUANTITATIF : ${asset.symbol} (${asset.category})</div>
        <div>• <strong>Signal Actif :</strong> ${asset.signal} (Confiance ${asset.conf}% • Backtest 68.4%)</div>
        <div>• <strong>Prix Actuel :</strong> ${formatNum(asset.price, asset.decimals)}</div>
        <div>• <strong>Entrée / SL / TP :</strong> ${formatNum(asset.entry, asset.decimals)} / ${formatNum(asset.sl, asset.decimals)} / ${formatNum(asset.tp, asset.decimals)}</div>
        <div>• <strong>Ratio Risk/Reward :</strong> 1 : ${rr}</div>
        <div>• <strong>Garde-fou Pare-feu :</strong> Risque max autorisé ${state.guardrails.maxRiskPct}% (${formatNum(state.balance * state.guardrails.maxRiskPct / 100, 2)} USDT).</div>
      `;
      document.getElementById('aiPromptModal').classList.remove('hidden');
    }

    function closeAiPromptModal() {
      document.getElementById('aiPromptModal').classList.add('hidden');
    }

    function copyAiPromptToClipboard() {
      const asset = getCurrentAsset();
      const promptText = `Analyse institutionnelle Vertex MASTER V2 sur ${asset.symbol} (${asset.category}) : Cours actuel ${asset.price}, Signal ${asset.signal} (${asset.conf}%), Entrée ${asset.entry}, Stop-Loss ${asset.sl}, Take-Profit ${asset.tp}. Valide la confluence MTF et le dimensionnement de lot pour un risque de ${state.guardrails.maxRiskPct}% sur un capital de ${state.balance.toFixed(2)} USDT.`;
      const ta = document.createElement('textarea');
      ta.value = promptText;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      ta.remove();
      showToast('Briefing actif copié dans le presse-papiers', '📋');
    }

    function runCustomAiPrompt() {
      const q = document.getElementById('customAiQuestion').value.trim();
      const asset = getCurrentAsset();
      const content = document.getElementById('aiModalContent');
      const maxLoss = (state.balance * (state.guardrails.maxRiskPct / 100)).toFixed(2);
      content.innerHTML += `
        <div class="mt-2 pt-2 border-t border-vx-border text-blue-300">
          <strong>Analyse IA (${q || 'Validation du risque'}) :</strong> Sur ${asset.symbol}, votre risque maximal autorisé (${state.guardrails.maxRiskPct}%) correspond à <strong>${maxLoss} USDT</strong>. Maintenez votre Stop-Loss à <strong>${formatNum(asset.sl, asset.decimals)}</strong>.
        </div>
      `;
      document.getElementById('customAiQuestion').value = '';
    }

    function exportStateJson() {
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(state, null, 2));
      const dlAnchor = document.createElement('a');
      dlAnchor.setAttribute("href", dataStr);
      dlAnchor.setAttribute("download", "vertex_master_v2_backup.json");
      document.body.appendChild(dlAnchor);
      dlAnchor.click();
      dlAnchor.remove();
      showToast('Sauvegarde JSON exportée avec succès', '⬇');
    }

    function importStateJson(event) {
      const file = event.target.files && event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function (e) {
        try {
          const imported = JSON.parse(e.target.result);
          if (typeof imported.balance === 'number') state.balance = imported.balance;
          if (Array.isArray(imported.openPositions)) state.openPositions = imported.openPositions;
          if (Array.isArray(imported.tradeHistory)) state.tradeHistory = imported.tradeHistory;
          if (imported.guardrails) state.guardrails = { ...state.guardrails, ...imported.guardrails };
          saveState();
          renderPortfolioTab();
          validateAndCalculateOrder();
          showToast('Sauvegarde JSON restaurée avec succès', '✅');
        } catch (err) {
          showToast('Fichier JSON invalide', '⚠️');
        }
      };
      reader.readAsText(file);
    }

    // =========================================================================
    // 15. REAL-TIME STREAMING LOOP (60FPS FLUIDITY, CANDLE TIMER & AUTO TP/SL)
    // =========================================================================
    function startLiveMarketStream() {
      setInterval(() => {
        const lat = Math.floor(Math.random() * 10) + 14;
        document.getElementById('latencyBadge').textContent = lat + 'ms';

        // Candle countdown timer
        state.candleSecondsLeft = state.candleSecondsLeft > 1 ? state.candleSecondsLeft - 1 : 59;
        const secPad = String(state.candleSecondsLeft).padStart(2, '0');
        const timerEl = document.getElementById('nextCandleTimer');
        if (timerEl) timerEl.textContent = `⏱ Bougie : 00:${secPad}`;

        // Live ATR Volatility indicator
        const volEl = document.getElementById('volatilityGaugeBadge');
        if (volEl) {
          const atrPct = (1.25 + Math.random() * 0.45).toFixed(2);
          volEl.textContent = `⚡ Volatilité : ${atrPct}% (Saine)`;
        }

        ASSETS.forEach(a => {
          const tick = (Math.random() - 0.492) * (a.price * 0.00045);
          a.price = Math.max(a.price * 0.2, a.price + tick);
        });

        const curAsset = getCurrentAsset();
        document.getElementById('quickBarPrice').textContent = formatNum(curAsset.price, curAsset.decimals);

        if (state.activeTab === 'terminal') {
          updateAssetLivePriceHeader(curAsset);
          if (state.candles.length > 0) {
            const last = state.candles[state.candles.length - 1];
            last.close = curAsset.price;
            if (curAsset.price > last.high) last.high = curAsset.price;
            if (curAsset.price < last.low) last.low = curAsset.price;
            drawChart();
          }
          if (state.proModules.orderbook) renderOrderbookModule();
          if (state.proModules.trades && Math.random() > 0.45) renderPublicTradesModule();
        } else if (state.activeTab === 'portfolio' && state.openPositions.length > 0) {
          renderPortfolioTab();
        }

        checkAutomatedClosuresAndAlerts();
      }, 1400);
    }

    function checkAutomatedClosuresAndAlerts() {
      for (let i = state.openPositions.length - 1; i >= 0; i--) {
        const pos = state.openPositions[i];
        const a = ASSETS.find(x => x.symbol === pos.symbol);
        if (!a) continue;

        let hitReason = null;
        if (pos.side === 'LONG') {
          if (a.price <= pos.sl) hitReason = 'Stop-Loss touché';
          else if (a.price >= pos.tp) hitReason = 'TP atteint';
        } else {
          if (a.price >= pos.sl) hitReason = 'SL touché';
          else if (a.price <= pos.tp) hitReason = 'TP atteint';
        }

        if (hitReason) {
          const diffRatio = pos.side === 'LONG'
            ? (a.price - pos.entry) / pos.entry
            : (pos.entry - a.price) / pos.entry;
          const pnl = pos.notional * diffRatio;
          state.balance += pos.margin + pnl;
          state.openPositions.splice(i, 1);
          state.tradeHistory.unshift({
            symbol: pos.symbol,
            side: pos.side,
            lev: pos.lev,
            reason: hitReason,
            time: new Date().toTimeString().slice(0, 5),
            pnl
          });
          saveState();
          renderPortfolioTab();
          showToast(`${pos.symbol} : ${hitReason} (${pnl >= 0 ? '+' : ''}${formatNum(pnl, 2)} USDT)`, '⚡');
        }
      }

      state.priceAlerts.forEach(alert => {
        if (alert.triggered) return;
        const a = ASSETS.find(x => x.symbol === alert.symbol);
        if (a && Math.abs(a.price - alert.price) / alert.price < 0.0015) {
          alert.triggered = true;
          showToast(`🔔 Alerte atteinte : ${alert.symbol} à ${formatNum(a.price, a.decimals)}`, '🔔');
        }
      });
    }

    // =========================================================================
    // 16. INITIALIZATION
    // =========================================================================
    window.onload = function () {
      loadSavedState();
      document.getElementById('catalogCount').textContent = ASSETS.length;

      document.getElementById('guardMaxPositions').value = state.guardrails.maxPositions;
      document.getElementById('guardMaxRiskPct').value = state.guardrails.maxRiskPct;
      document.getElementById('guardMaxDrawdownPct').value = state.guardrails.maxDrawdownPct;
      document.getElementById('guardMinRR').value = state.guardrails.minRR;

      window.addEventListener('resize', () => {
        if (state.activeTab === 'terminal') drawChart();
        if (state.activeTab === 'portfolio') renderPortfolioTab();
      });

      syncProCheckboxesUI();
      selectAsset(state.activeSymbol, true);
      renderSignalsTab();
      renderPortfolioTab();
      renderNewsTab();
      renderCalendarTab();
      startLiveMarketStream();
    };
  </script>
</body>
</html>
